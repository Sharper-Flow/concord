{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/linear-setup.v1.schema.json",
  "title": "Concord Linear setup binding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "teams", "projects", "status_policy"],
  "properties": {
    "schema_version": {"const": "linear-setup.v1"},
    "workspace_id": {"type": "string", "minLength": 2, "maxLength": 128},
    "teams": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/team"}},
    "projects": {"type": "array", "maxItems": 128, "items": {"$ref": "#/$defs/project"}},
    "status_policy": {"$ref": "#/$defs/status_policy"}
  },
  "$defs": {
    "team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "team_id"],
      "properties": {
        "product_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "team_id": {"type": "string", "minLength": 2, "maxLength": 128}
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "linear_project_id", "team_id"],
      "properties": {
        "project_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "linear_project_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "team_id": {"type": "string", "minLength": 2, "maxLength": 128}
      }
    },
    "status_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed_id", "cancelled_id", "superseded_id", "duplicate_id"],
      "properties": {
        "completed_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "cancelled_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "superseded_id": {"type": "string", "minLength": 2, "maxLength": 128},
        "duplicate_id": {"type": "string", "minLength": 2, "maxLength": 128}
      }
    }
  }
}
