{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/native-run-statuses.schema.json",
  "title": "Concord native-run status vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "summary", "phases"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "summary": {"type": "string", "minLength": 2, "maxLength": 1024},
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/phase"}
    }
  },
  "$defs": {
    "term": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "failure"],
      "properties": {
        "status": {"$ref": "#/$defs/term"},
        "failure": {"type": "boolean"}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "statuses"],
      "properties": {
        "phase": {"$ref": "#/$defs/term"},
        "statuses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/status"}
        }
      }
    }
  }
}
