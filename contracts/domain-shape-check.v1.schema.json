{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/domain-shape-check.v1.schema.json",
  "title": "Product-declared Domain Shape command protocol",
  "description": "One UTF-8 JSON document on stdin/stdout, at most 32768 bytes each. Commands run only through an explicitly authorized host/operator runner, never on reads. Product commands resolve source languages and anchors. Complete means a whole inventory, not pass. The host compares observations. Subject must exactly equal the request. Ratchet data is one Product-owned file, never automatically updated. Input facts and roots are validated against the selected Product before this protocol; graph edges are only depends_on. JSON duplicate keys, nulls and trailing documents refuse.",
  "oneOf": [{ "$ref": "#/$defs/input" }, { "$ref": "#/$defs/output" }],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$" },
    "tool_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\*?\\[\\]{}]+(?:/[^\\\\*?\\[\\]{}]+)*$", "not": { "pattern": "//|/$" } },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["product_id", "project_id", "commit_oid", "content_hash"],
      "properties": {
        "product_id": { "$ref": "#/$defs/id" }, "project_id": { "$ref": "#/$defs/id" },
        "commit_oid": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "root": {
      "type": "object", "additionalProperties": false, "required": ["path", "role"],
      "properties": {
        "path": { "$ref": "#/$defs/path" }, "role": { "enum": ["domain", "mixed", "composition", "test_support"] },
        "owner_domain_id": { "$ref": "#/$defs/id" },
        "domain_ids": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      },
      "allOf": [
        { "if": { "properties": { "role": { "const": "domain" } } }, "then": { "required": ["owner_domain_id"], "not": { "required": ["domain_ids"] } } },
        { "if": { "properties": { "role": { "const": "mixed" } } }, "then": { "required": ["domain_ids"], "not": { "required": ["owner_domain_id"] } } },
        { "if": { "properties": { "role": { "enum": ["composition", "test_support"] } } }, "then": { "not": { "anyOf": [{ "required": ["owner_domain_id"] }, { "required": ["domain_ids"] }] } } }
      ]
    },
    "edge": {
      "type": "object", "additionalProperties": false, "required": ["source_domain_id", "target_domain_id"],
      "properties": { "source_domain_id": { "$ref": "#/$defs/id" }, "target_domain_id": { "$ref": "#/$defs/id" } }
    },
    "import": {
      "type": "object", "additionalProperties": false, "required": ["source_root", "target_root"],
      "properties": { "source_root": { "$ref": "#/$defs/path" }, "target_root": { "$ref": "#/$defs/path" } }
    },
    "ratchet": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "mixed_roots", "imports"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "mixed_roots": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/path" } },
        "imports": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/import" } }
      }
    },
    "repository_anchor": {
      "type": "object", "additionalProperties": false, "required": ["project_id", "path", "symbol"],
      "properties": { "project_id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" }, "symbol": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "\\S" } }
    },
    "enforcement_anchor": {
      "type": "object", "additionalProperties": false, "required": ["kind", "value", "check_id"],
      "properties": {
        "kind": { "enum": ["adapter_test", "generated", "go_test", "scenario", "validator"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "\\S" },
        "check_id": { "$ref": "#/$defs/tool_id" }
      }
    },
    "data_object": {
      "type": "object", "additionalProperties": false, "required": ["owning_root", "resource_id", "name"],
      "properties": { "owning_root": { "$ref": "#/$defs/path" }, "resource_id": { "type": "string", "minLength": 1, "maxLength": 256 }, "name": { "type": "string", "minLength": 1, "maxLength": 256 } }
    },
    "config_read": {
      "type": "object", "additionalProperties": false, "required": ["owning_root", "setting", "source", "read_by"],
      "properties": { "owning_root": { "$ref": "#/$defs/path" }, "setting": { "type": "string", "minLength": 1, "maxLength": 256 }, "source": { "type": "string", "minLength": 1, "maxLength": 1024 }, "read_by": { "$ref": "#/$defs/repository_anchor" } }
    },
    "repository_resolution": {
      "type": "object", "additionalProperties": false, "required": ["anchor", "resolved"],
      "properties": { "anchor": { "$ref": "#/$defs/repository_anchor" }, "resolved": { "type": "boolean" } }
    },
    "enforcement_resolution": {
      "type": "object", "additionalProperties": false, "required": ["anchor", "resolved", "required_check_ids"],
      "properties": {
        "anchor": { "$ref": "#/$defs/enforcement_anchor" }, "resolved": { "type": "boolean" },
        "required_check_ids": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/tool_id" }, "description": "Observed required-check membership from Product configuration, not requested membership or successful check execution." }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "operation", "subject", "roots", "depends_on", "facts", "repository_anchors", "enforcement_anchors", "required_checks", "strict", "ratchet"],
      "properties": {
        "schema_version": { "const": "1.0" }, "operation": { "enum": ["boundary", "data_objects", "config_reads", "references"] },
        "subject": { "$ref": "#/$defs/subject" },
        "roots": { "type": "array", "maxItems": 512, "items": { "$ref": "#/$defs/root" } },
        "depends_on": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/edge" } },
        "facts": { "type": "array", "maxItems": 512, "items": { "$ref": "domain-fact.v1.schema.json" } },
        "repository_anchors": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/repository_anchor" } },
        "enforcement_anchors": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/enforcement_anchor" } },
        "required_checks": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/tool_id" } },
        "strict": { "type": "boolean" }, "ratchet": { "$ref": "#/$defs/ratchet" }
      }
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["schema_version", "operation", "subject", "complete"],
      "properties": {
        "schema_version": { "const": "1.0" }, "operation": { "enum": ["boundary", "data_objects", "config_reads", "references"] },
        "subject": { "$ref": "#/$defs/subject" }, "complete": { "const": true },
        "imports": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/import" } },
        "data_objects": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/data_object" } },
        "config_reads": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/config_read" } },
        "repository_anchors": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/repository_resolution" } },
        "enforcement_anchors": { "type": "array", "maxItems": 512, "uniqueItems": true, "items": { "$ref": "#/$defs/enforcement_resolution" } }
      },
      "oneOf": [
        { "properties": { "operation": { "const": "boundary" } }, "required": ["imports"], "not": { "anyOf": [{ "required": ["data_objects"] }, { "required": ["config_reads"] }, { "required": ["repository_anchors"] }, { "required": ["enforcement_anchors"] }] } },
        { "properties": { "operation": { "const": "data_objects" } }, "required": ["data_objects"], "not": { "anyOf": [{ "required": ["imports"] }, { "required": ["config_reads"] }, { "required": ["repository_anchors"] }, { "required": ["enforcement_anchors"] }] } },
        { "properties": { "operation": { "const": "config_reads" } }, "required": ["config_reads"], "not": { "anyOf": [{ "required": ["imports"] }, { "required": ["data_objects"] }, { "required": ["repository_anchors"] }, { "required": ["enforcement_anchors"] }] } },
        { "properties": { "operation": { "const": "references" } }, "required": ["repository_anchors", "enforcement_anchors"], "not": { "anyOf": [{ "required": ["imports"] }, { "required": ["data_objects"] }, { "required": ["config_reads"] }] } }
      ]
    }
  }
}
