{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/domain-fact.v1.schema.json",
  "title": "Domain fact shard v1",
  "description": "One UTF-8 JSON shard named <id>.json, at most 16384 bytes. Duplicate keys and trailing content refuse. Parser also validates same-Product current Domain, owning-root, current accepted law, invariant and resolved repository/required-check anchor references; resource IDs are bounded fact-local source strings with no registration lookup. Reference declarations do not prove execution or extractor verification. Text, name, path, symbol, environment and resource limits additionally apply in UTF-8 bytes; existing knowledge-reference identity limits count Unicode code points.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "owner_domain_id", "owning_root", "standing"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/id"},
    "kind": {"enum": ["invariant", "data_object", "state_authority", "config_coupling"]},
    "owner_domain_id": {"$ref": "#/$defs/referenceID"},
    "owning_root": {"$ref": "#/$defs/path"},
    "standing": {"enum": ["law", "observed"]},
    "governing_law_ids": {"$ref": "#/$defs/nonemptyIDs"},
    "invariant": {"$ref": "#/$defs/invariant"},
    "data_object": {"$ref": "#/$defs/dataObject"},
    "state_authority": {"$ref": "#/$defs/stateAuthority"},
    "config_coupling": {"$ref": "#/$defs/configCoupling"}
  },
  "allOf": [
    {
      "if": {"properties": {"standing": {"const": "law"}}},
      "then": {"required": ["governing_law_ids"]},
      "else": {"not": {"required": ["governing_law_ids"]}}
    }
  ],
  "oneOf": [
    {"properties": {"kind": {"const": "invariant"}}, "required": ["invariant"], "not": {"anyOf": [{"required": ["data_object"]}, {"required": ["state_authority"]}, {"required": ["config_coupling"]}]}},
    {"properties": {"kind": {"const": "data_object"}}, "required": ["data_object"], "not": {"anyOf": [{"required": ["invariant"]}, {"required": ["state_authority"]}, {"required": ["config_coupling"]}]}},
    {"properties": {"kind": {"const": "state_authority"}}, "required": ["state_authority"], "not": {"anyOf": [{"required": ["invariant"]}, {"required": ["data_object"]}, {"required": ["config_coupling"]}]}},
    {"properties": {"kind": {"const": "config_coupling"}}, "required": ["config_coupling"], "not": {"anyOf": [{"required": ["invariant"]}, {"required": ["data_object"]}, {"required": ["state_authority"]}]}}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "referenceID": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "resourceID": {"type": "string", "minLength": 1, "maxLength": 256},
    "text": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\\\*?\\[\\]{}]+(?:/[^\\\\*?\\[\\]{}]+)*$", "not": {"pattern": "//|/$"}},
    "ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/referenceID"}},
    "nonemptyIDs": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
    "repositoryAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "path", "symbol"],
      "properties": {
        "project_id": {"$ref": "#/$defs/referenceID"},
        "path": {"$ref": "#/$defs/path"},
        "symbol": {"$ref": "#/$defs/name"}
      }
    },
    "enforcementAnchor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "value", "check_id"],
      "properties": {
        "kind": {"enum": ["adapter_test", "generated", "go_test", "scenario", "validator"]},
        "value": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
        "check_id": {"$ref": "#/$defs/id"}
      }
    },
    "invariant": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "applies_to_domain_ids", "enforced_by"],
      "properties": {
        "statement": {"$ref": "#/$defs/text"},
        "applies_to_domain_ids": {"$ref": "#/$defs/nonemptyIDs"},
        "enforced_by": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/enforcementAnchor"}}
      }
    },
    "dataObject": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "resource_id", "writer_domain_ids", "reader_domain_ids", "invariant_ids"],
      "properties": {
        "name": {"$ref": "#/$defs/name"},
        "resource_id": {"$ref": "#/$defs/resourceID"},
        "writer_domain_ids": {"$ref": "#/$defs/ids"},
        "reader_domain_ids": {"$ref": "#/$defs/ids"},
        "invariant_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "derivedCopy": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_id", "rebuild_route"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/resourceID"},
        "rebuild_route": {"$ref": "#/$defs/repositoryAnchor"}
      }
    },
    "stateAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "authoritative_resource_id", "derived_copies", "disagreement_behavior"],
      "properties": {
        "state": {"$ref": "#/$defs/text"},
        "authoritative_resource_id": {"$ref": "#/$defs/resourceID"},
        "derived_copies": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/derivedCopy"}},
        "disagreement_behavior": {"$ref": "#/$defs/text"}
      }
    },
    "configCoupling": {
      "type": "object", "additionalProperties": false,
      "required": ["setting", "source", "read_by", "effect", "environments"],
      "properties": {
        "setting": {"$ref": "#/$defs/name"},
        "source": {"$ref": "#/$defs/text"},
        "read_by": {"$ref": "#/$defs/repositoryAnchor"},
        "effect": {"$ref": "#/$defs/text"},
        "environments": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"}}
      }
    }
  }
}
