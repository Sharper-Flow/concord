{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/lane-step-dispatch.schema.json",
  "title": "Concord lane-to-step dispatch join vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "summary", "bindings"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "summary": {"type": "string", "minLength": 2, "maxLength": 2048},
    "bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "capability_class": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]*$"},
    "step_kind": {"enum": ["internal_sqlite", "cross_authority", "external_effect"]},
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_class", "step_kinds"],
      "properties": {
        "capability_class": {"$ref": "#/$defs/capability_class"},
        "step_kinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/step_kind"}
        }
      }
    }
  }
}
