      "mechanism": "capture records a needed item before its plan is chosen",
      "initial_state": {"work": "new"},
      "action": "capture",
      "expected": {"assertions": [
        {"target": "state", "path": "work.lifecycle", "op": "eq", "value": "needed"},
        {"target": "communication", "path": "error", "op": "absent"},
        {"target": "effects", "path": "work.created_event", "op": "nonempty"}
