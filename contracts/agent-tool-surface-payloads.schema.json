    "direction":{"type":"string","enum":["outgoing","incoming","both"]},
    "lifecycle":{"type":"string","enum":["needed","in_progress","completed","cancelled"]},
    "work_kind":{"type":"string","enum":["task","bug","decision","research","epic","other"]},
