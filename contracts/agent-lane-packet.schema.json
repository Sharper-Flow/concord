{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-lane-packet.schema.json",
  "title": "Concord agent lane packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "lane_id",
    "lane_version",
    "lane_digest",
    "work_id",
    "step_id",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ],
      "description": "The packet identity this packet records. \"1.0\" is the released packet: it never carries inputs.worker_job. \"1.1\" is the job-capable packet (CD-0205): it may carry inputs.worker_job when the dispatcher selected a ready worker-job revision."
    },
    "attempt_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "lane_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "lane_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "lane_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "binding"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binding": {
          "$ref": "#/$defs/lane_packet_binding"
        },
        "worker_job": {
          "$ref": "#/$defs/lane_packet_worker_job"
        },
        "context": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384,
          "description": "Prose context a packet built before the typed record members carried. The lane-packet schema keeps it so a retained packet from an attempt dispatched before that change still validates on recovery. The core dispatch admission refuses it, so no new packet carries it."
        },
        "law_context": {
          "description": "The approved contract's binding law and Domains the pinned continuity resolved. The core refuses a dispatch whose packet member differs from the current recorded state, omits a present record, or carries a member no record backs.",
          "$ref": "#/$defs/lane_law_context"
        },
        "design_record": {
          "description": "The current typed design record (CD-0128). The core refuses a dispatch whose packet member differs from the current recorded state, omits a present record, or carries a member no record backs.",
          "$ref": "#/$defs/lane_design_record"
        },
        "proposal_record": {
          "description": "The recorded proposal's problem, user outcomes, and constraints. The core refuses a dispatch whose packet member differs from the current recorded state, omits a present record, or carries a member no record backs.",
          "$ref": "#/$defs/lane_proposal_record"
        },
        "work_record": {
          "$ref": "#/$defs/lane_work_record"
        },
        "correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "attempt_count",
            "attempt_limit",
            "escalated",
            "diagnosis",
            "strategy",
            "predicate_ids",
            "evidence_refs"
          ],
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "failed",
                "rejected",
                "verification"
              ]
            },
            "attempt_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "attempt_limit": {
              "const": 3
            },
            "escalated": {
              "type": "boolean"
            },
            "diagnosis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "strategy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "failure_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "failure_detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "predicate_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "failed_attempt_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "failed_attempt_epoch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "source_event_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "The durable failure, rejection, or correction-request event that opened this correction. The diagnosis and strategy are that event's directions. The core refuses a packet whose correction names a different source than the current correction."
            },
            "source_event_seq": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          }
        },
        "work_context": {
          "$ref": "#/$defs/lane_work_context_view",
          "description": "CON-887: the current work-context view the work pin carried when the packet was built. The core refuses a dispatch whose packet does not consume the current view byte-for-byte, exactly as it refuses a packet that skips a durable correction."
        },
        "checkpoint": {
          "$ref": "#/$defs/lane_context_checkpoint",
          "description": "CON-883: the latest context checkpoint the pinned continuity projection carried when the packet was built, with its durable identity. The core refuses a dispatch whose packet does not carry the latest checkpoint byte-for-byte; its strategy and diagnosis are coordinator directions to follow."
        },
        "constraints": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "outcome_predicates": {
          "$ref": "#/$defs/lane_outcome_predicates"
        }
      }
    }
  },
  "$defs": {
    "lane_packet_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_source",
        "work_version",
        "contract_version",
        "assigned_result"
      ],
      "properties": {
        "objective_source": {
          "type": "string",
          "enum": [
            "contract_premise",
            "work_question"
          ],
          "description": "Where inputs.task came from: contract_premise is the approved contract premise carried verbatim; work_question is the recorded work question carried before contract approval."
        },
        "work_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "The applicable contract version, or null when no contract applies."
        },
        "assigned_result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The one evidence obligation whose discharge completes this attempt, derived from the registered lane."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "objective_source": {
                "const": "contract_premise"
              }
            },
            "required": [
              "objective_source"
            ]
          },
          "then": {
            "properties": {
              "contract_version": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objective_source": {
                "const": "work_question"
              }
            },
            "required": [
              "objective_source"
            ]
          },
          "then": {
            "properties": {
              "contract_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "lane_outcome_predicates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/lane_outcome_predicate"
      }
    },
    "lane_outcome_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "ordinal",
        "outcome_kind",
        "outcome_payload"
      ],
      "properties": {
        "predicate_id": {
          "type": "string",
          "minLength": 11,
          "maxLength": 128,
          "pattern": "^predicate:[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "The store refuses a predicate_id without the \"predicate:\" prefix. Write ids in the form \"predicate:<name>\"."
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "outcome_kind": {
          "type": "string",
          "enum": [
            "exists",
            "absent",
            "outcome",
            "check"
          ]
        },
        "outcome_payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exists",
                "absent",
                "outcome",
                "check"
              ]
            },
            "surface": {
              "$ref": "#/$defs/lane_predicate_surface"
            },
            "subjects": {
              "$ref": "#/$defs/lane_predicate_subjects"
            },
            "distinguish_from": {
              "$ref": "#/$defs/lane_predicate_distinguish_from"
            },
            "allowed": {
              "$ref": "#/$defs/lane_predicate_allowed"
            },
            "decision_record": {
              "$ref": "#/$defs/lane_predicate_decision_record"
            },
            "check_ref": {
              "$ref": "#/$defs/lane_predicate_check_ref"
            },
            "immutable_subject_ref": {
              "$ref": "#/$defs/lane_predicate_immutable_subject_ref"
            },
            "expected_result": {
              "$ref": "#/$defs/lane_predicate_expected_result"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "exists"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_exists"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "absent"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_absent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "outcome"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_outcome"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "check"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_check"
              }
            }
          }
        }
      ]
    },
    "lane_predicate_surface": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:/-]{1,127}$"
    },
    "lane_predicate_subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{1,127}$"
      }
    },
    "lane_predicate_payload_exists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "surface",
        "subjects"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "exists"
        },
        "surface": {
          "$ref": "#/$defs/lane_predicate_surface"
        },
        "subjects": {
          "$ref": "#/$defs/lane_predicate_subjects"
        }
      }
    },
    "lane_predicate_payload_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "surface",
        "subjects",
        "distinguish_from"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "absent"
        },
        "surface": {
          "$ref": "#/$defs/lane_predicate_surface"
        },
        "subjects": {
          "$ref": "#/$defs/lane_predicate_subjects"
        },
        "distinguish_from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "archived",
              "relocated",
              "renamed",
              "disabled"
            ]
          }
        }
      }
    },
    "lane_predicate_payload_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allowed"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "outcome"
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "no_change",
              "accepted_decision",
              "insufficient_evidence",
              "resolved",
              "remediated",
              "report_recorded",
              "completed",
              "operator_defined"
            ]
          }
        },
        "decision_record": {
          "$ref": "#/$defs/lane_predicate_decision_record"
        }
      }
    },
    "lane_predicate_decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options_considered",
        "decision",
        "rationale",
        "consequences",
        "inputs",
        "poc_findings",
        "supersedes",
        "superseded_by",
        "unknowns",
        "required_to_decide",
        "reviewer_actor_ref",
        "operator_approval_ref"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "options_considered": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted_decision",
            "insufficient_evidence"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "poc_findings": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "unknowns": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        },
        "required_to_decide": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        },
        "reviewer_actor_ref": {
          "type": "string",
          "minLength": 70,
          "maxLength": 70,
          "pattern": "^actor:[0-9a-f]{64}$"
        },
        "operator_approval_ref": {
          "type": "string",
          "minLength": 9,
          "maxLength": 136,
          "pattern": "^approval:[a-z0-9][a-z0-9_.:/-]{1,127}$"
        }
      }
    },
    "lane_predicate_payload_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "check_ref",
        "immutable_subject_ref",
        "expected_result"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "check"
        },
        "check_ref": {
          "type": "string",
          "minLength": 7,
          "maxLength": 134,
          "pattern": "^check:[a-z][a-z0-9_.:/-]{1,127}$"
        },
        "immutable_subject_ref": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.:/-]{1,255}$"
        },
        "expected_result": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "pass",
            "fail",
            "present",
            "absent",
            "healthy",
            "unhealthy",
            "accepted",
            "rejected"
          ]
        }
      }
    },
    "lane_predicate_distinguish_from": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "archived",
          "relocated",
          "renamed",
          "disabled"
        ]
      }
    },
    "lane_predicate_allowed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "no_change",
          "accepted_decision",
          "insufficient_evidence",
          "resolved",
          "remediated",
          "report_recorded",
          "completed",
          "operator_defined"
        ]
      }
    },
    "lane_predicate_check_ref": {
      "type": "string",
      "minLength": 7,
      "maxLength": 134,
      "pattern": "^check:[a-z][a-z0-9_.:/-]{1,127}$"
    },
    "lane_predicate_immutable_subject_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_.:/-]{1,255}$"
    },
    "lane_predicate_expected_result": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "pass",
        "fail",
        "present",
        "absent",
        "healthy",
        "unhealthy",
        "accepted",
        "rejected"
      ]
    },
    "lane_packet_worker_job": {
      "type": "object",
      "additionalProperties": false,
      "description": "The selected ready worker-job revision this attempt executes (CD-0205). The core refuses a packet whose worker_job is not a ready recorded revision with this exact content, and refuses the member on a pinned definition that predates worker jobs. inputs.task stays the complete parent contract premise; this object bounds the attempt's own objective.",
      "required": [
        "job_id",
        "revision",
        "digest",
        "objective",
        "stopping_condition",
        "project_scope",
        "path_scope",
        "predicate_ids",
        "checks",
        "prerequisites",
        "unresolved_refs",
        "reserved_integration"
      ],
      "properties": {
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
          "minLength": 2,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "minLength": 71,
          "maxLength": 71
        },
        "objective": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "stopping_condition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "project_scope": {
          "type": "string",
          "maxLength": 128,
          "minLength": 0
        },
        "path_scope": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0
        },
        "predicate_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^predicate:[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "minLength": 11,
            "maxLength": 128
          },
          "minItems": 0
        },
        "checks": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "minItems": 0
        },
        "prerequisites": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "job_id",
              "revision"
            ],
            "properties": {
              "job_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{1,127}$",
                "minLength": 2,
                "maxLength": 128
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "result_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "minItems": 0
        },
        "unresolved_refs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0
        },
        "reserved_integration": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 0
        }
      }
    },
    "lane_work_context_view": {
      "type": "object",
      "additionalProperties": false,
      "description": "The core reader's current work-context view (CON-887), carried verbatim from the work pin. Every bound mirrors internal/store WorkContextView exactly.",
      "required": [
        "source_event_frontier",
        "required_reading",
        "findings",
        "domain_groups"
      ],
      "properties": {
        "source_event_frontier": {
          "type": "integer",
          "minimum": 0,
          "description": "The highest sequence among the work item's context-source events (declarations and terminal worker reports) the view was assembled at."
        },
        "required_reading": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/lane_work_context_reading"
          }
        },
        "findings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/lane_work_context_finding_view"
          }
        },
        "domain_groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/lane_work_context_domain_group"
          }
        }
      }
    },
    "lane_work_context_reading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "reason",
        "source"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "product_wide_rationale": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "source": {
          "oneOf": [
            {
              "$ref": "#/$defs/lane_work_context_reading_source_repository_file"
            },
            {
              "$ref": "#/$defs/lane_work_context_reading_source_knowledge"
            }
          ]
        }
      }
    },
    "lane_work_context_reading_source_repository_file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "project_id",
        "path",
        "commit_oid"
      ],
      "properties": {
        "kind": {
          "const": "repository_file"
        },
        "project_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "description": "A normalized relative repository-contained path at the pinned commit; read the pinned Git bytes, not the changed checkout."
        },
        "commit_oid": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{40,64}$"
        }
      }
    },
    "lane_work_context_reading_source_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_id",
        "law_id",
        "content_hash"
      ],
      "properties": {
        "kind": {
          "const": "knowledge"
        },
        "source_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "law_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        "content_hash": {
          "type": "string",
          "minLength": 71,
          "maxLength": 71,
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "lane_work_context_finding_view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "kind",
        "statement",
        "subject_ref",
        "evidence_refs",
        "domain_id",
        "origin",
        "status",
        "source_event_id",
        "source_event_seq",
        "ordinal"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 11,
          "maxLength": 64,
          "pattern": "^finding:[0-9]+:[0-9]+$",
          "description": "Core-derived from the source event sequence and ordinal; never authored."
        },
        "kind": {
          "type": "string",
          "enum": [
            "observation",
            "inference",
            "hypothesis",
            "rejected_approach",
            "open_question",
            "contradiction",
            "direction"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "product_wide_rationale": {
          "type": "string",
          "minLength": 0,
          "maxLength": 512
        },
        "origin": {
          "type": "string",
          "enum": [
            "declaration",
            "worker_report"
          ]
        },
        "status": {
          "const": "reported",
          "description": "A finding is a reported claim, never acceptance."
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source_event_seq": {
          "type": "integer",
          "minimum": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lane_work_context_domain_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "required_reading_ordinals",
        "finding_ids",
        "domain_cards"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "required_reading_ordinals": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "finding_ids": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 11,
            "maxLength": 64,
            "pattern": "^finding:[0-9]+:[0-9]+$"
          }
        },
        "domain_cards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "description": "The reserved per-Domain card slot. The current foundation never generates cards."
        }
      }
    },
    "lane_context_checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "description": "The owning continuity reader's latest context checkpoint (CON-883), carried verbatim from the pinned continuity projection. Every bound mirrors internal/store ContextCheckpoint exactly; the projection carries no source event identity, so checkpoint_id, work_version, and sequence are the durable identity.",
      "required": [
        "checkpoint_id",
        "work_version",
        "sequence",
        "step_id",
        "attempt_epoch",
        "active_unit",
        "hypothesis",
        "diagnosis",
        "strategy",
        "touched_refs",
        "evidence_refs",
        "pending_questions",
        "pending_decisions"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "work_version": {
          "type": "integer",
          "minimum": 1
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "step_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128
        },
        "attempt_epoch": {
          "type": "integer",
          "minimum": 1
        },
        "active_unit": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256
        },
        "hypothesis": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096
        },
        "diagnosis": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096
        },
        "strategy": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096,
          "description": "Coordinator direction the worker follows for this attempt."
        },
        "touched_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^\\S+$",
            "description": "A workflow reference list item: whitespace-free, 2-128 chars, matching the store's ValidReference. Slashes are allowed because touched refs name repository paths."
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^\\S+$",
            "description": "A workflow reference list item: whitespace-free, 2-128 chars, matching the store's ValidReference."
          }
        },
        "pending_questions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^\\S+$"
          }
        },
        "pending_decisions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^\\S+$"
          }
        }
      }
    },
    "lane_law_context": {
      "description": "The approved contract's binding law and Domains, resolved at continuity read time from the law_subjects and domains projections. Absent when the contract binds no law and no Domain.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "laws",
        "domains"
      ],
      "properties": {
        "laws": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/lane_law_context_law"
          },
          "minItems": 0
        },
        "domains": {
          "type": "array",
          "maxItems": 65,
          "items": {
            "$ref": "#/$defs/lane_law_context_domain"
          },
          "minItems": 0
        },
        "registry_path": {
          "description": "The repository path of the Domain registry shard. Present when the context binds at least one Domain, so a dispatched lane reads Domain structure from the file instead of a Concord tool.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "lane_law_context_law": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roles",
        "law_id"
      ],
      "properties": {
        "roles": {
          "description": "Every binding role the approved contract gives the law, sorted and deduplicated.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "mandated",
              "modified",
              "added",
              "obligation"
            ]
          }
        },
        "law_id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "obligation_ids": {
          "description": "The contract's verification obligations that name the law, sorted and deduplicated. Present only when roles carries obligation.",
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
          }
        },
        "kind": {
          "description": "The law_subjects record kind. Constitution records are law-bearing and project into law_subjects, so a contract can mandate them.",
          "type": "string",
          "enum": [
            "constitution",
            "decision",
            "spec"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "accepted",
            "superseded"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "criteria": {
          "description": "The law's acceptance criteria bound to the reading work item's own outcome predicates (CD-0180). Present only when at least one criterion binds this work item.",
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/lane_law_context_criterion"
          }
        }
      }
    },
    "lane_law_context_domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "name",
        "purpose"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "name": {
          "type": "string",
          "maxLength": 256,
          "minLength": 0
        },
        "purpose": {
          "type": "string",
          "maxLength": 4096,
          "minLength": 0
        }
      }
    },
    "lane_law_context_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion",
        "predicate_id"
      ],
      "properties": {
        "criterion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "predicate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "lane_design_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_version",
        "approach",
        "decisions",
        "touched_refs",
        "recorded_at"
      ],
      "properties": {
        "work_version": {
          "type": "integer",
          "minimum": 1
        },
        "approach": {
          "type": "string",
          "minLength": 2,
          "maxLength": 4096
        },
        "decisions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/lane_design_decision"
          }
        },
        "touched_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 128,
            "pattern": "^\\S+$"
          }
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 0,
          "maxLength": 64
        }
      }
    },
    "lane_design_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "choice",
        "rationale",
        "rejected"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 2,
          "maxLength": 128,
          "pattern": "^\\S+$"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "choice": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "rejected": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        }
      }
    },
    "lane_proposal_record": {
      "description": "The recorded proposal fields the dispatched lane packet renders. Absent when no proposal is recorded.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "user_outcomes",
        "constraints"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "user_outcomes": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0
        },
        "constraints": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "minItems": 0
        }
      }
    },
    "lane_work_record": {
      "description": "The work item's recorded value statement, task, and narrative, each verbatim and present exactly when the recorded text is not blank. The core refuses a dispatch whose packet member differs from the recorded work item.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "value_statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "narrative": {
          "type": "string",
          "minLength": 1,
          "maxLength": 16384
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "not": {
              "required": [
                "worker_job"
              ]
            }
          }
        }
      }
    }
  ]
}
