#!/usr/bin/env bash
#
# Repository-local verification throttle wrapper.
#
# Tiers:
#   smoke       Go packages CI tests without shards, adapter tests, and
#               JSON/law validation.
#   targeted    Caller-supplied command and arguments, passed through unchanged.
#   conformance Gated production-like ten-process conformance harness.
#   preflight   Lefthook pre-push gates (lefthook.yml), pinned to v2.1.14.
#
# Smoke leaves out the packages CI splits into shard jobs (internal/store and
# cmd/concord). Its Go step is CI's "Test every package without its own shard
# job" command, and scripts/test-oc-test.py fails when the two differ. To test
# one shard locally, run CI's selection for it, for example shard 1 of 5:
#
#   bin/oc-test targeted -- go test -timeout=15m -run "$(python3 scripts/go-test-shard.py ./internal/store 1 5)" ./internal/store
#
# Host admission control is provided by `oc-test-gate` when it is installed.
# When it is missing the tier still runs, unthrottled, after a warning. Smoke
# uses smoke admission; targeted uses ungated targeted admission; conformance
# uses full admission; preflight uses smoke admission because its gates vet,
# build, lint, and compile every package, which is heavy on a shared host when
# several worktrees push at once. The
# continuous-integration workflow does not use this wrapper; it calls the same
# underlying commands natively so its behavior stays deterministic.
#
# The tier above and the gate's admission class are separate vocabularies. A
# tier names a workload this repository owns. An admission class names a
# throttling behavior the host tool owns, and `oc-test-gate` accepts only
# `targeted`, `smoke`, and `full`. Passing a tier name where a class belongs
# makes the gate exit 2 with `unknown tier`.
#
# Every tier runs under a kernel file-size limit (RLIMIT_FSIZE), set as both
# the soft and the hard limit so no test process can raise it. The default is
# 1024 MiB per file. A process that writes past it receives SIGXFSZ and the
# tier fails (exit 153 for a process the signal kills). Raise it for one run,
# never to unlimited, with OC_TEST_MAX_FILE_MIB:
#
#   OC_TEST_MAX_FILE_MIB=4096 bin/oc-test targeted -- <command>
#
# A stricter limit inherited from the caller is kept.

set -euo pipefail
# POSIX mode counts `ulimit -f` in 512-byte blocks; the limit below is KiB.
set +o posix

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat >&2 <<'USAGE'
Usage: bin/oc-test smoke | targeted -- <command> [args...] | conformance | preflight

  smoke        Go packages CI tests without shards, adapter suite, and JSON/law validation under host admission control
  targeted     caller-supplied command and arguments without heavy admission
  conformance  long uninstrumented ten-process SQLite harness under host admission control
  preflight    Lefthook pre-push gates from lefthook.yml under smoke admission

Every tier limits each written file to OC_TEST_MAX_FILE_MIB (default 1024) MiB.
USAGE
  exit 64
}

max_file_mib="${OC_TEST_MAX_FILE_MIB:-1024}"
if [[ ! "$max_file_mib" =~ ^[1-9][0-9]{0,6}$ ]]; then
  printf 'bin/oc-test: OC_TEST_MAX_FILE_MIB must be a whole number of MiB from 1 to 9999999, got %q\n' "$max_file_mib" >&2
  exit 64
fi

# Apply the per-file limit to this shell and everything it starts.
file_limit_kib=$((max_file_mib * 1024))
limit_file_size() {
  local hard
  hard="$(ulimit -H -f)"
  if [[ "$hard" != unlimited && "$hard" -lt "$file_limit_kib" ]]; then
    file_limit_kib="$hard"
  fi
  ulimit -f "$file_limit_kib"
}

# Run a workload, wrapped in host admission control when it is available.
# The first argument is the tier this wrapper reports. The second is the
# admission class the host gate understands.
run_tier() {
  local tier="$1"
  local admission_class="$2"
  shift 2

  local -a gate=()
  if command -v oc-test-gate >/dev/null 2>&1; then
    gate=(oc-test-gate "$admission_class" --)
  else
    printf 'bin/oc-test: oc-test-gate not found on PATH; running the %s tier unthrottled.\n' "$tier" >&2
    printf 'bin/oc-test: concurrent runs on this machine are not admission-controlled.\n' >&2
  fi

  limit_file_size
  printf 'START %s\n' "$tier"
  local rc=0
  if [[ ${#gate[@]} -gt 0 && "$admission_class" != targeted ]]; then
    printf 'WAIT admission: %s (shared heavy-test slot)\n' "$tier"
  fi
  set +e
  if [[ ${#gate[@]} -gt 0 ]]; then
    "${gate[@]}" "$@"
  else
    "$@"
  fi
  rc=$?
  set -e
  if [[ "$rc" -eq 0 ]]; then
    printf 'PASS %s\n' "$tier"
  else
    printf 'FAIL %s (exit %s)\n' "$tier" "$rc" >&2
    if [[ "$rc" -eq 153 ]]; then
      printf 'bin/oc-test: a process was killed by SIGXFSZ: it wrote past the %s KiB per-file limit (OC_TEST_MAX_FILE_MIB).\n' "$file_limit_kib" >&2
    fi
  fi
  exit "$rc"
}

tier="${1:-}"
[[ -n "$tier" ]] || usage
shift || true
# `targeted` accepts an optional `--` separator before its command. Tiers
# that take no arguments must refuse it, so remember whether one was eaten.
consumed_separator=0
if [[ "${1:-}" == "--" ]]; then
  consumed_separator=1
  shift
fi

case "$tier" in
  smoke)
    [[ $# -eq 0 ]] || usage
    run_tier smoke smoke bash -euo pipefail -c '
      go test -timeout=15m $(go list ./... | grep -v -x -F -e github.com/sharper-flow/concord/internal/store -e github.com/sharper-flow/concord/cmd/concord)
      env -u CONCORD_SELECTED_PRODUCT_ID bun test adapter/opencode/
      env -u CONCORD_SELECTED_PRODUCT_ID CONCORD_REQUIRE_BUN=1 python3 scripts/check-json.py --adapter-tests-external
    '
    ;;
  targeted)
    [[ $# -gt 0 ]] || usage
    run_tier targeted targeted "$@"
    ;;
  conformance)
    [[ $# -eq 0 ]] || usage
    run_tier conformance full env CONCORD_CONFORMANCE_LONG=1 go test -count=1 -run '^TestTenProcessConformance$' ./internal/store -v
    ;;
  preflight)
    [[ $# -eq 0 && "$consumed_separator" -eq 0 ]] || usage
    # The pinned lefthook release runs the pre-push gates from lefthook.yml.
    # Prefer an installed binary; otherwise run the pinned module version.
    # Never install or mutate git hooks from here: lefthook.yml sets
    # no_auto_install, and installing hooks is a one-time contributor step
    # documented in CONTRIBUTING.md.
    if command -v lefthook >/dev/null 2>&1; then
      run_tier preflight smoke lefthook run pre-push
    else
      printf 'bin/oc-test: lefthook binary not found on PATH; using the pinned module.\n' >&2
      run_tier preflight smoke go run github.com/evilmartians/lefthook/v2@v2.1.14 run pre-push
    fi
    ;;
  *)
    usage
    ;;
esac
