{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-tool-surface.schema.json",
  "title": "Concord canonical agent tool surface manifest IR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "surface",
    "envelope",
    "tools",
    "operations",
    "schemas",
    "capabilities",
    "consequences",
    "bounds",
    "generation",
    "payload_digest",
    "digest"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "1.0"
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "tool_count"
      ],
      "properties": {
        "name": {
          "const": "concord-agent-tool-surface"
        },
        "tool_count": {
          "const": 9
        }
      }
    },
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "schema_ref",
        "outcomes",
        "origins",
        "max_bytes"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "schema_ref": {
          "const": "contracts/agent-tool-envelope.schema.json"
        },
        "outcomes": {
          "type": "array",
          "const": [
            "ok",
            "pending",
            "partial",
            "error"
          ]
        },
        "origins": {
          "type": "array",
          "const": [
            "core",
            "adapter"
          ]
        },
        "max_bytes": {
          "const": 65536
        }
      }
    },
    "tools": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "operations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^concord_[a-z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 48,
      "maxItems": 48,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tool",
          "kind",
          "query_id",
          "input_schema",
          "result_schema",
          "capability",
          "consequence",
          "approval",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^concord_[a-z0-9_]+\\.[a-z0-9_]+$"
          },
          "tool": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "read",
              "mutation"
            ]
          },
          "availability": {
            "enum": [
              "always",
              "workflow_definition"
            ]
          },
          "query_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(PM1\\.Q([1-9]|1[01]|12|13|14)|C14\\.ProductRows|C19\\.Continuity|C21\\.InitiativeEntries)$"
          },
          "input_schema": {
            "type": "string",
            "pattern": "^#/schemas/[a-z0-9_]+$"
          },
          "result_schema": {
            "type": "string",
            "pattern": "^#/schemas/[a-z0-9_]+$"
          },
          "capability": {
            "enum": [
              "cross_scope",
              "product_read",
              "research",
              "work_compact",
              "work_define",
              "work_initiative",
              "work_relate",
              "work_transition"
            ]
          },
          "consequence": {
            "enum": [
              "read",
              "intent",
              "lifecycle",
              "workflow_action",
              "scope",
              "relation",
              "supersession",
              "publication",
              "recovery",
              "research",
              "claim"
            ]
          },
          "approval": {
            "enum": [
              "none",
              "conditional",
              "required"
            ]
          },
          "metadata": {
            "$ref": "#/$defs/metadata"
          }
        }
      }
    },
    "schemas": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/schemaRef"
      },
      "minProperties": 2
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "cross_scope",
          "product_read",
          "research",
          "work_compact",
          "work_define",
          "work_initiative",
          "work_relate",
          "work_transition"
        ]
      },
      "uniqueItems": true,
      "minItems": 8,
      "maxItems": 8
    },
    "consequences": {
      "type": "array",
      "items": {
        "enum": [
          "read",
          "intent",
          "lifecycle",
          "workflow_action",
          "scope",
          "relation",
          "supersession",
          "publication",
          "recovery",
          "research",
          "claim"
        ]
      },
      "uniqueItems": true,
      "minItems": 11,
      "maxItems": 11
    },
    "bounds": {
      "$ref": "#/$defs/bounds"
    },
    "generation": {
      "$ref": "#/$defs/generation"
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "schemaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "closed"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "const": true
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context",
        "idempotency",
        "pagination",
        "output_bytes",
        "versions"
      ],
      "properties": {
        "context": {
          "enum": [
            "ambient",
            "explicit",
            "workflow",
            "portfolio"
          ]
        },
        "idempotency": {
          "enum": [
            "request_id",
            "required"
          ]
        },
        "pagination": {
          "enum": [
            "none",
            "cursor"
          ]
        },
        "output_bytes": {
          "const": 65536
        },
        "versions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_output_bytes",
        "max_items",
        "max_warnings",
        "max_omissions",
        "max_evidence_refs",
        "max_changed_refs",
        "max_next_intents",
        "max_candidates",
        "max_violations"
      ],
      "properties": {
        "max_output_bytes": {
          "const": 65536
        },
        "max_items": {
          "const": 100
        },
        "max_warnings": {
          "const": 16
        },
        "max_omissions": {
          "const": 16
        },
        "max_evidence_refs": {
          "const": 32
        },
        "max_changed_refs": {
          "const": 32
        },
        "max_next_intents": {
          "const": 16
        },
        "max_candidates": {
          "const": 20
        },
        "max_violations": {
          "const": 20
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targets",
        "digest_excludes"
      ],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 3,
          "uniqueItems": true
        },
        "digest_excludes": {
          "const": [
            "digest"
          ]
        }
      }
    }
  }
}
