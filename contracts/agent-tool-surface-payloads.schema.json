    "blocked_work_page":{"type":"object","additionalProperties":false,"required":["items","nodes","edges"],"properties":{"items":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/work_summary"}},"nodes":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/work_summary"}},"edges":{"type":"array","maxItems":200,"items":{"type":"object","additionalProperties":false,"required":["from","to","kind"],"properties":{"from":{"$ref":"#/$defs/id"},"to":{"$ref":"#/$defs/id"},"kind":{"type":"string","enum":["blocks","parent"]}}}},"next_cursor":{"$ref":"#/$defs/cursor"}}},
