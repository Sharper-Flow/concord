{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-lanes.schema.json",
  "title": "Concord agent lane registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry", "version", "lanes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry": {"const": "agent_lanes"},
    "version": {"const": 1},
    "lanes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/lane"}}
  },
  "$defs": {
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "purpose", "capability_class", "capabilities", "packet_schema_ref", "report_schema_ref", "budgets", "evidence_obligations", "lifecycle_states"],
      "properties": {
        "id": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z][a-z0-9_-]*$"},
        "version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "purpose": {"type": "string", "minLength": 2, "maxLength": 512},
        "capability_class": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
        "capabilities": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"}},
        "packet_schema_ref": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$"},
        "report_schema_ref": {"type": "string", "minLength": 2, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*$"},
        "budgets": {"$ref": "#/$defs/budgets"},
        "evidence_obligations": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_obligation"}},
        "lifecycle_states": {"type": "array", "minItems": 3, "maxItems": 4, "uniqueItems": true, "items": {"enum": ["dispatched", "completed", "failed"]}}
      }
    },
    "evidence_obligation": {
      "enum": ["bounded_findings", "commands", "contract_findings", "exit_codes", "failure_classification", "files_touched", "severity", "source_citations", "uncertainties", "unresolved_issues", "verification_commands"]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cost_usd_max", "context_tokens_max", "time_seconds_max"],
      "properties": {
        "cost_usd_max": {"type": "number", "minimum": 0.01, "maximum": 1000},
        "context_tokens_max": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "time_seconds_max": {"type": "integer", "minimum": 1, "maximum": 86400}
      }
    }
  }
}
