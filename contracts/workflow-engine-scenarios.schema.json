{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/workflow-engine-scenarios.schema.json",
  "title": "Concord current workflow-engine scenario corpus v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "contract", "contract_status", "engine_status", "pending_amendments", "fixtures", "assertion_contract", "runner_requirements", "scenarios"],
  "properties": {
    "$schema": {"type": "string", "minLength": 1, "maxLength": 256},
    "schema_version": {"const": "1.0"},
    "contract": {"const": "CD-0013"},
    "contract_status": {"const": "accepted"},
    "engine_status": {"type": "string", "enum": ["specification_only", "engine_shipped"]},
    "pending_amendments": {
      "type": "array", "minItems": 0, "maxItems": 8, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["error_kind", "ships_with", "status"],
        "properties": {"error_kind": {"$ref": "#/$defs/id"}, "ships_with": {"const": "workflow_engine"}, "status": {"const": "pending"}}
      }
    },
    "fixtures": {"$ref": "#/$defs/fixtures"},
    "assertion_contract": {"$ref": "#/$defs/assertionContract"},
    "runner_requirements": {"$ref": "#/$defs/runnerRequirements"},
    "scenarios": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/scenario"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{1,127}$", "minLength": 2, "maxLength": 128},
    "short": {"type": "string", "minLength": 1, "maxLength": 4096},
    "actorRef": {"type": "string", "pattern": "^actor:[0-9a-f]{64}$", "minLength": 70, "maxLength": 70},
    "actorIdentityRef": {"type": "string", "pattern": "^[^\\x09-\\x0d \\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]+$", "minLength": 1, "maxLength": 128, "x-minBytes": 2, "x-maxBytes": 128},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "minLength": 71, "maxLength": 71},
    "currentAction": {"type": "string", "enum": ["capture", "add_condition", "resolve_condition", "cancel_condition", "record_proposal", "approve_contract", "record_verdict", "complete", "accept_worker_result"]},
    "jsonValue": {"oneOf": [
      {"type": "null"}, {"type": "boolean"},
      {"type": "integer", "minimum": -2147483648, "maximum": 2147483647},
      {"type": "string", "minLength": 0, "maxLength": 4096},
      {"type": "array", "minItems": 0, "maxItems": 100, "items": {"$ref": "#/$defs/jsonValue"}},
      {"type": "object", "minProperties": 0, "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
    ]},
    "jsonObject": {
      "type": "object", "minProperties": 0, "maxProperties": 64, "additionalProperties": false,
      "properties": {"work": {"$ref": "#/$defs/jsonValue"}, "outcome": {"$ref": "#/$defs/jsonValue"}, "condition_id": {"$ref": "#/$defs/jsonValue"}}
    },
    "workItem": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "state", "definition_ref"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"type": "string", "enum": ["implementation", "break_fix", "research"]},
        "state": {"type": "string", "enum": ["planned", "ready", "running", "blocked", "awaiting_condition", "verifying", "completed", "cancelled", "superseded"]},
        "definition_ref": {"$ref": "#/$defs/id"}
      }
    },
    "actor": {
      "type": "object", "additionalProperties": false, "required": ["actor_ref", "principal_ref", "client_ref", "agent_ref", "session_ref", "actor_class"],
      "properties": {
        "actor_ref": {"$ref": "#/$defs/actorRef"}, "principal_ref": {"$ref": "#/$defs/actorIdentityRef"}, "client_ref": {"$ref": "#/$defs/actorIdentityRef"},
        "agent_ref": {"$ref": "#/$defs/actorIdentityRef"}, "session_ref": {"$ref": "#/$defs/actorIdentityRef"}, "actor_class": {"type": "string", "enum": ["agent", "operator"]}
      }
    },
    "definitionRef": {"type": "object", "additionalProperties": false, "required": ["ref"], "properties": {"ref": {"$ref": "#/$defs/id"}}},
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["id", "kind", "subject", "producer", "run"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"type": "string", "enum": ["verification", "review", "approval", "commit", "durable_note", "native_run", "artifact"]},
        "subject": {"$ref": "#/$defs/short"}, "producer": {"$ref": "#/$defs/id"}, "run": {"$ref": "#/$defs/id"}
      }
    },
    "fixtures": {
      "type": "object", "additionalProperties": false, "required": ["work_items", "actors", "definitions", "evidence", "relations"],
      "properties": {
        "work_items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/workItem"}},
        "actors": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/actor"}},
        "definitions": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/definitionRef"}},
        "evidence": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"$ref": "#/$defs/evidence"}},
        "relations": {"type": "array", "minItems": 0, "maxItems": 0, "items": false}
      }
    },
    "fixtureRefs": {
      "type": "object", "additionalProperties": false, "required": ["work_item", "actors", "definitions", "evidence", "relations"],
      "properties": {
        "work_item": {"$ref": "#/$defs/id"},
        "actors": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/actorRef"}},
        "definitions": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evidence": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "relations": {"type": "array", "minItems": 0, "maxItems": 0, "items": false}
      }
    },
    "scenarioSetup": {
      "type": "object", "additionalProperties": false, "required": ["fixture_refs", "current_state", "faults"],
      "properties": {
        "fixture_refs": {"$ref": "#/$defs/fixtureRefs"},
        "current_state": {
          "type": "object", "additionalProperties": false, "required": ["step"],
          "properties": {
            "step": {"$ref": "#/$defs/id"},
            "proof_case": {"type": "string", "enum": ["planning_without_outcome", "weaker_delivery", "satisfied_delivery", "implement_verdict", "completion_rollback", "impact_notice_identity", "missing_definition", "evidence_commit_mismatch", "lane_pipeline", "one_conjunct_weaker"]}
          }
        },
        "faults": {"type": "array", "minItems": 0, "maxItems": 0, "items": false}
      }
    },
    "idempotencyInput": {
      "type": "object", "additionalProperties": false, "required": ["key", "request_id", "operation_id", "accepted_inputs_digest"],
      "properties": {"key": {"$ref": "#/$defs/id"}, "request_id": {"$ref": "#/$defs/id"}, "operation_id": {"$ref": "#/$defs/id"}, "accepted_inputs_digest": {"$ref": "#/$defs/digest"}}
    },
    "grantInput": {
      "type": "object", "additionalProperties": false, "required": ["principal_ref", "client_ref", "agent_ref", "session_ref", "capability", "scope"],
      "properties": {
        "principal_ref": {"$ref": "#/$defs/actorIdentityRef"}, "client_ref": {"$ref": "#/$defs/actorIdentityRef"}, "agent_ref": {"$ref": "#/$defs/actorIdentityRef"}, "session_ref": {"$ref": "#/$defs/actorIdentityRef"},
        "capability": {"type": "string", "enum": ["work_transition", "workflow_action", "workflow_read"]}, "scope": {"$ref": "#/$defs/id"}
      }
    },
    "approvalInput": {
      "type": "object", "additionalProperties": false, "required": ["required", "approval_ref"],
      "properties": {"required": {"type": "boolean"}, "approval_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}}
    },
    "operationInput": {
      "type": "object", "additionalProperties": false, "required": ["op_id"],
      "properties": {"op_id": {"$ref": "#/$defs/id"}}
    },
    "requestFields": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "payload": {"$ref": "#/$defs/jsonObject"}, "title": {"$ref": "#/$defs/short"}, "value_statement": {"$ref": "#/$defs/short"},
        "project_ids": {"type": "array", "minItems": 0, "maxItems": 32, "items": {"$ref": "#/$defs/id"}},
        "premise": {"$ref": "#/$defs/short"},
        "problem": {"$ref": "#/$defs/short"},
        "affected": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/short"}},
        "stakes": {"$ref": "#/$defs/short"},
        "user_outcomes": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/short"}},
        "current_commit": {"type": "string", "minLength": 40, "maxLength": 64, "pattern": "^[0-9a-f]+$"},
        "evidence_commit": {"type": "string", "minLength": 40, "maxLength": 64, "pattern": "^[0-9a-f]+$"},
        "decision_domains": {"type": "array", "minItems": 0, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["preference", "product", "ui_ux"]}},
        "impact_verdict": {"type": "string", "enum": ["breaking", "non-breaking"]},
        "verdicts": {"type": "array", "minItems": 1, "maxItems": 8, "items": {
          "type": "object", "additionalProperties": false, "required": ["predicate_id", "receipt_refs"],
          "properties": {
            "predicate_id": {"$ref": "#/$defs/id"},
            "receipt_refs": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/short"}}
          }
        }},
        "attempt_id": {"$ref": "#/$defs/id"},
        "attempt_epoch": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      }
    },
    "scenarioRequest": {
      "type": "object", "additionalProperties": false, "required": ["actor_ref", "definition_ref", "action_id", "fields", "idempotency", "grant", "approval", "operation"],
      "if": {"properties": {"action_id": {"type": "string", "enum": ["capture", "add_condition", "resolve_condition", "cancel_condition"]}}},
      "then": {"properties": {"fields": {"required": ["payload"]}}},
      "properties": {
        "actor_ref": {"$ref": "#/$defs/actorRef"}, "definition_ref": {"$ref": "#/$defs/id"}, "expected_version": {"type": "integer", "minimum": 1},
        "action_id": {"$ref": "#/$defs/currentAction"}, "fields": {"$ref": "#/$defs/requestFields"}, "idempotency": {"$ref": "#/$defs/idempotencyInput"},
        "grant": {"$ref": "#/$defs/grantInput"}, "approval": {"$ref": "#/$defs/approvalInput"}, "operation": {"$ref": "#/$defs/operationInput"}
      }
    },
    "readObservation": {
      "type": "object", "additionalProperties": false, "required": ["target", "path", "op"],
      "properties": {
        "target": {"type": "string", "enum": ["state", "result", "communication", "effects"]}, "path": {"$ref": "#/$defs/short"},
        "op": {"type": "string", "enum": ["eq", "absent", "nonempty"]}, "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "scenarioObservations": {
      "type": "object", "additionalProperties": false, "required": ["expected_reads"],
      "properties": {"expected_reads": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/readObservation"}}}
    },
    "assertionContract": {
      "type": "object", "additionalProperties": false, "required": ["required_fields", "targets", "ops"],
      "properties": {
        "required_fields": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["target", "path", "op"]}},
        "targets": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "enum": ["state", "result", "communication", "effects"]}},
        "ops": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "enum": ["eq", "nonempty", "absent"]}}
      }
    },
    "runnerRequirements": {
      "type": "object", "additionalProperties": false, "required": ["passing_rule", "mutation_oracle", "stub_resistance", "required_measurements", "evaluation_order"],
      "properties": {
        "passing_rule": {"$ref": "#/$defs/short"}, "mutation_oracle": {"$ref": "#/$defs/short"}, "stub_resistance": {"$ref": "#/$defs/short"},
        "required_measurements": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "evaluation_order": {"$ref": "#/$defs/short"}
      }
    },
    "assertion": {
      "type": "object", "additionalProperties": false, "required": ["target", "path", "op"],
      "properties": {
        "target": {"type": "string", "enum": ["state", "result", "communication", "effects"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 256},
        "op": {"type": "string", "enum": ["eq", "nonempty", "absent"]}, "value": {"$ref": "#/$defs/jsonValue"}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false, "required": ["assertions"],
      "properties": {
        "assertions": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/assertion"}},
        "invariants": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["id", "initial_state", "action", "setup", "request", "observations", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "initial_state": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "action": {"$ref": "#/$defs/currentAction"}, "setup": {"$ref": "#/$defs/scenarioSetup"}, "request": {"$ref": "#/$defs/scenarioRequest"},
        "observations": {"$ref": "#/$defs/scenarioObservations"}, "expected": {"$ref": "#/$defs/expected"}
      }
    },
    "scenario": {
      "type": "object", "additionalProperties": false, "required": ["id", "scenario_number", "mechanism", "initial_state", "action", "setup", "request", "observations"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "scenario_number": {"type": "integer", "minimum": 1, "maximum": 57}, "mechanism": {"$ref": "#/$defs/short"},
        "initial_state": {"type": "object", "minProperties": 1, "maxProperties": 64, "additionalProperties": {"$ref": "#/$defs/jsonValue"}},
        "action": {"$ref": "#/$defs/currentAction"}, "setup": {"$ref": "#/$defs/scenarioSetup"}, "request": {"$ref": "#/$defs/scenarioRequest"},
        "observations": {"$ref": "#/$defs/scenarioObservations"}, "expected": {"$ref": "#/$defs/expected"},
        "cases": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/case"}}
      },
      "anyOf": [{"required": ["expected"]}, {"required": ["cases"]}]
    }
  }
}
