{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/concord-knowledge-index.v1.schema.json",
  "title": "Concord durable knowledge index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supported_kinds",
    "indexed_kinds",
    "domain_registry",
    "records"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.2",
        "1.3"
      ]
    },
    "supported_kinds": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "work_note",
          "constitution",
          "decision",
          "spec",
          "lesson",
          "reference",
          "research"
        ]
      }
    },
    "indexed_kinds": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "work_note",
          "constitution",
          "decision",
          "spec",
          "lesson",
          "reference",
          "research"
        ]
      }
    },
    "domain_registry": {
      "$ref": "#/$defs/domainRegistry"
    },
    "knowledge_roots": {
      "$ref": "#/$defs/knowledgeRoots"
    },
    "exclusions": {
      "$ref": "#/$defs/knowledgeExclusions"
    },
    "dispositions": {
      "$ref": "#/$defs/dispositions"
    },
    "doc_contract": {
      "$ref": "#/$defs/docContract"
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/recordV12"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "description": "CD-0159 D3: the standing of a law record, beside status. legislated_by and contract_version name the operator-approved work contract that fixed the legislated standing; they are required exactly when the tier is legislated.",
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "legislated",
            "derived"
          ]
        },
        "legislated_by": {
          "$ref": "#/$defs/id"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": "legislated"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "required": [
              "legislated_by",
              "contract_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": "derived"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "legislated_by"
                  ]
                },
                {
                  "required": [
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "evidencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![\\s\\S]*\\.\\.)[\\s\\S]+$"
    },
    "ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "scopeCommon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "product_ids",
        "project_ids",
        "tag_ids"
      ],
      "properties": {
        "mode": {
          "enum": [
            "home",
            "explicit"
          ]
        },
        "product_ids": {
          "$ref": "#/$defs/ids"
        },
        "project_ids": {
          "$ref": "#/$defs/ids"
        },
        "domain_ids": {
          "$ref": "#/$defs/ids"
        },
        "tag_ids": {
          "$ref": "#/$defs/ids"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "home"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "product_ids": {
                "maxItems": 0
              },
              "project_ids": {
                "maxItems": 0
              },
              "tag_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "scopeV12": {
      "allOf": [
        {
          "$ref": "#/$defs/scopeCommon"
        },
        {
          "type": "object",
          "required": [
            "domain_ids"
          ],
          "properties": {
            "domain_ids": {
              "$ref": "#/$defs/ids"
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "home"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "domain_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "status",
        "date",
        "title",
        "summary",
        "tags",
        "scopes",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "kind": {
          "enum": [
            "constitution",
            "decision",
            "spec",
            "lesson",
            "reference",
            "research"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^docs/(?!work/|research/|.*[Gg][Ee][Nn][Ee][Rr][Aa][Tt][Ee][Dd]).*\\.md$",
          "maxLength": 512
        },
        "status": {
          "enum": [
            "accepted",
            "published",
            "superseded"
          ]
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tags": {
          "$ref": "#/$defs/ids"
        },
        "scopes": {
          "$ref": "#/$defs/scopeV12"
        },
        "successor": {
          "$ref": "#/$defs/id"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "law_relations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lawRelation"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        },
        "criterion_bindings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/criterionBinding"
          }
        },
        "home_domain_id": {
          "$ref": "#/$defs/id"
        },
        "applies_to_domain_ids": {
          "$ref": "#/$defs/ids"
        },
        "product_wide_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "doc_contract_profile": {
          "description": "CD-0175: the authored outline generation a decision record carries. 'legacy' keeps the pre-amendment outline; 'current' carries the manifest head's current_required_sections. Required on every decision record once the manifest head declares doc_contract.decision.current_required_sections, absent-allowed before that declaration, and invalid on every other kind; the legacy profile is bounded by $defs.legacyDecisionProfileId.",
          "enum": [
            "legacy",
            "current"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "published",
                  "superseded"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "spec"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "superseded"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^docs/decisions/CD-[0-9]{4}(-.*)?\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "superseded"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "successor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "accepted",
                  "published"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "not": {
              "required": [
                "successor"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "law_relations": {}
            },
            "required": [
              "law_relations"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "decision",
                  "spec"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "criterion_bindings"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "spec",
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "doc_contract_profile"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              },
              "doc_contract_profile": {
                "const": "legacy"
              }
            },
            "required": [
              "kind",
              "doc_contract_profile"
            ]
          },
          "then": {
            "properties": {
              "id": {
                "$ref": "#/$defs/legacyDecisionProfileId"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              },
              "id": {
                "not": {
                  "$ref": "#/$defs/legacyDecisionProfileId"
                }
              }
            },
            "required": [
              "kind",
              "id"
            ]
          },
          "then": {
            "properties": {
              "doc_contract_profile": {
                "const": "current"
              }
            }
          }
        }
      ]
    },
    "recordV12": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "properties": {
            "scopes": {
              "$ref": "#/$defs/scopeV12"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "spec"
                ]
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "kind",
              "status"
            ]
          },
          "then": {
            "required": [
              "home_domain_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "home_domain_id"
                  ]
                },
                {
                  "required": [
                    "applies_to_domain_ids"
                  ]
                },
                {
                  "required": [
                    "product_wide_rationale"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "applies_to_domain_ids"
            ]
          },
          "then": {
            "required": [
              "home_domain_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "home_domain_id": {
                "pattern": "^product-root:"
              }
            },
            "required": [
              "home_domain_id"
            ]
          },
          "then": {
            "required": [
              "product_wide_rationale"
            ]
          },
          "else": {
            "not": {
              "required": [
                "product_wide_rationale"
              ]
            }
          }
        }
      ]
    },
    "domainRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_key",
        "root_domain_id",
        "domains"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "product_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "root_domain_id": {
          "type": "string",
          "pattern": "^product-root:[a-z][a-z0-9-]{1,63}$"
        },
        "domains": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/domain"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "name",
        "purpose",
        "status",
        "architecture_relations"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parent_domain_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "current",
            "deprecated"
          ]
        },
        "architecture_relations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/architectureRelation"
          }
        }
      }
    },
    "architectureRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_domain_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "depends_on",
            "shares_contract_with",
            "replaces"
          ]
        },
        "target_domain_id": {
          "$ref": "#/$defs/id"
        },
        "governing_law_ids": {
          "$ref": "#/$defs/ids"
        },
        "state": {
          "enum": [
            "declared",
            "building",
            "coexisting",
            "cutover",
            "retired"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "depends_on",
                  "shares_contract_with"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "governing_law_ids"
            ],
            "properties": {
              "governing_law_ids": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "state"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "replaces"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "state"
            ],
            "not": {
              "required": [
                "governing_law_ids"
              ]
            }
          }
        }
      ]
    },
    "lawRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "supersedes",
            "refines",
            "subordinate_to",
            "conflicts_with"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "criterionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion"
      ],
      "properties": {
        "criterion": {
          "type": "integer",
          "minimum": 1
        },
        "scenario": {
          "$ref": "#/$defs/id"
        },
        "exemption": {
          "type": "string",
          "minLength": 12,
          "maxLength": 512,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "oneOf": [
        {
          "required": [
            "scenario"
          ],
          "not": {
            "required": [
              "exemption"
            ]
          }
        },
        {
          "required": [
            "exemption"
          ],
          "not": {
            "required": [
              "scenario"
            ]
          }
        }
      ]
    },
    "knowledgeRoots": {
      "type": "array",
      "default": [
        "docs/"
      ],
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*/$",
        "maxLength": 256
      }
    },
    "knowledgeExclusions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*(?:/|\\.md)$",
        "maxLength": 256
      }
    },
    "dispositions": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![\\s\\S]*\\.\\.)[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.md$"
        },
        "disposition": {
          "enum": [
            "archived"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "docContract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enforced": {
          "type": "boolean",
          "default": false
        },
        "constitution": {
          "$ref": "#/$defs/docContractKind"
        },
        "decision": {
          "$ref": "#/$defs/docContractKind"
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required_sections",
            "ac_required"
          ],
          "properties": {
            "required_sections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            },
            "ac_required": {
              "type": "boolean"
            }
          }
        },
        "lesson": {
          "$ref": "#/$defs/docContractKind"
        },
        "reference": {
          "$ref": "#/$defs/docContractKind"
        },
        "research": {
          "$ref": "#/$defs/docContractKind"
        },
        "banned_phrases": {
          "type": "array",
          "default": [
            "in order to",
            "utilize",
            "leverage",
            "it is important to note",
            "needless to say",
            "at the end of the day"
          ],
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "activation": {
          "description": "Numerical convergence criterion that must fully hold before enforced flips to true (issue #319). Recorded before activation; enforced=true requires this object.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_registered_findings",
            "max_unresolved_criteria",
            "max_false_positives",
            "evidence"
          ],
          "properties": {
            "max_registered_findings": {
              "type": "integer",
              "const": 0,
              "description": "scripts/check-doc-contract.py report mode: zero findings over registered records"
            },
            "max_unresolved_criteria": {
              "type": "integer",
              "const": 0,
              "description": "zero unbound or mis-bound acceptance criteria on spec records"
            },
            "max_false_positives": {
              "type": "integer",
              "const": 0,
              "description": "scripts/test-doc-contract.py green and every remaining report-mode finding reviewed as a true positive"
            },
            "evidence": {
              "type": "string",
              "minLength": 12,
              "maxLength": 1024
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enforced": {
                "const": true
              }
            },
            "required": [
              "enforced"
            ]
          },
          "then": {
            "required": [
              "activation"
            ]
          }
        }
      ]
    },
    "legacyDecisionProfileId": {
      "description": "CD-0175: the closed historical boundary of the decision outline. The decision record identifiers accepted before the outline amendment; the set never grows. A decision record declares the legacy profile exactly when its id is a member, so a newly accepted decision cannot exempt itself from the current outline.",
      "enum": [
