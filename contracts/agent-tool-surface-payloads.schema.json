    "budget":{"type":"object","additionalProperties":false,"required":["max_bytes","max_items"],"properties":{"max_bytes":{"type":"integer","minimum":1,"maximum":65536},"max_items":{"type":"integer","minimum":1,"maximum":100},"max_millis":{"type":"integer","minimum":1,"maximum":300000}}},
    "field":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"$ref":"#/$defs/short"},"value":{"type":["string","number","boolean","null"]}}},
