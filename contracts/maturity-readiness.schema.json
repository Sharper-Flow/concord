{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/maturity-readiness.schema.json",
  "title": "Concord maturity-readiness manifest",
  "description": "Closed contract for a per-rung maturity-readiness manifest defined by CD-0091. It records a Product's distance from one maturity rung, reusing the floor-readiness state model and the shared evidence_anchors machinery. Every condition decomposes into bounded items whose state is one of satisfied, outstanding, unmeasured, or out_of_scope. A satisfied item binds a typed executable anchor, never a cited path.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rung", "source", "conditions", "items"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "rung": {
      "description": "The maturity rung this manifest measures. The condition and item ids carry the rung's first letter, so one file measures one rung.",
      "type": "string",
      "enum": ["alpha", "beta", "production"]
    },
    "source": {
      "description": "Provenance: the decision and section the rung bar is copied from. For every rung this is CD-0091. Unlike the floor manifest, the maturity manifest does not bind condition titles to source sentences, because CD-0091 states the bar as prose rather than an itemised floor.",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "section"],
      "properties": {
        "path": { "type": "string", "minLength": 5, "maxLength": 512 },
        "section": { "type": "string", "minLength": 2, "maxLength": 256 }
      }
    },
    "conditions": {
      "description": "The rung conditions. Every condition must carry at least one item. The id prefix is the rung's first letter followed by an ordinal.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ordinal", "title"],
        "properties": {
          "id": { "type": "string", "pattern": "^[abp][0-9]{1,2}$" },
          "ordinal": { "type": "integer", "minimum": 1, "maximum": 32 },
          "title": { "type": "string", "minLength": 2, "maxLength": 512 }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "condition", "title", "requirement", "state"],
        "properties": {
          "id": { "type": "string", "pattern": "^[abp][0-9]{1,2}-[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
          "condition": { "type": "string", "pattern": "^[abp][0-9]{1,2}$" },
          "title": { "type": "string", "minLength": 2, "maxLength": 256 },
          "requirement": { "type": "string", "minLength": 16, "maxLength": 2048 },
          "state": { "type": "string", "enum": ["satisfied", "outstanding", "unmeasured", "out_of_scope"] },
          "evidence": {
            "description": "Typed executable anchors that prove a satisfied state. Each carries a closed {kind, value} pair from {go_test, scenario, validator, generated}, resolved by the shared evidence_anchors machinery. Required when satisfied; forbidden otherwise.",
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "value"],
              "properties": {
                "kind": { "type": "string", "enum": ["go_test", "scenario", "validator", "generated", "adapter_test"] },
                "value": { "type": "string", "minLength": 3, "maxLength": 512 }
              }
            }
          },
          "issue": {
            "description": "Public issue number tracking an outstanding item. Required when outstanding; forbidden otherwise.",
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "reason": {
            "description": "Why an item is unmeasured or out of scope. Required for those states; forbidden otherwise.",
            "type": "string",
            "minLength": 16,
            "maxLength": 2048
          }
        },
        "allOf": [
          {
            "if": { "properties": { "state": { "const": "satisfied" } } },
            "then": { "required": ["evidence"], "not": { "anyOf": [{ "required": ["issue"] }, { "required": ["reason"] }] } }
          },
          {
            "if": { "properties": { "state": { "const": "outstanding" } } },
            "then": { "required": ["issue"], "not": { "anyOf": [{ "required": ["evidence"] }, { "required": ["reason"] }] } }
          },
          {
            "if": { "properties": { "state": { "const": "unmeasured" } } },
            "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["evidence"] }, { "required": ["issue"] }] } }
          },
          {
            "if": { "properties": { "state": { "const": "out_of_scope" } } },
            "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["evidence"] }, { "required": ["issue"] }] } }
          }
        ]
      }
    }
  }
}
