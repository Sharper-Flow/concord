{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-lane-report.schema.json",
  "title": "Concord agent lane report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "readback_model",
    "status",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "readback_model": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.-]*(/[a-zA-Z0-9][a-zA-Z0-9._-]*)+$"
    },
    "status": {
      "enum": [
        "completed",
        "failed"
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/evidence_entry"
      }
    },
    "base_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/base_comparison_check"
          }
        }
      }
    }
  },
  "$defs": {
    "evidence_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation",
        "detail"
      ],
      "properties": {
        "obligation": {
          "$ref": "#/$defs/evidence_obligation"
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxBytes": 512
        }
      }
    },
    "evidence_obligation": {
      "enum": [
        "bounded_findings",
        "commands",
        "contract_findings",
        "exit_codes",
        "failure_classification",
        "files_touched",
        "severity",
        "source_citations",
        "uncertainties",
        "unresolved_issues",
        "verification_commands",
        "visual_artifacts"
      ]
    },
    "base_comparison_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "branch_result",
        "base_result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "x-maxBytes": 512
        },
        "branch_result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        },
        "base_result": {
          "enum": [
            "pass",
            "fail",
            "not_run"
          ]
        }
      }
    }
  }
}
