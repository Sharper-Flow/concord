# Local build output
/concord
/bin/*
!/bin/oc-test

# Go tooling and editor state
*.test
*.out
coverage.out
__pycache__/
*.pyc
*.pyo
.DS_Store
.idea/
.vscode/

# Predecessor tooling artifact. Advance may write project.json into a working
# copy; Concord never reads it and must never commit it (CD-0010).
/project.json

# Host agent tooling writes package manifests, dependencies, and plugin
# configuration into .opencode/. Only the generated lane agent definitions are
# Concord-owned, so the directory is ignored except for those.
/.opencode/*
!/.opencode/agents/
