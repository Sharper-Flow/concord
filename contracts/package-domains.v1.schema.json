{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Package-grain Domain roots",
  "description": "Architecture data, not law. The entire UTF-8 document is bounded to 16384 bytes. Runtime validation resolves current Domains; the filesystem validator proves contained directory/module roots, canonical bytes and code coverage. Schema 1.0 roots are transitional mixed, never exclusive owners.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "packages"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "packages": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/historical"}}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "packages"],
      "properties": {
        "schema_version": {"const": "1.1"},
        "packages": {"type": "array", "maxItems": 512, "items": {"oneOf": [{"$ref": "#/$defs/domain"}, {"$ref": "#/$defs/mixed"}, {"$ref": "#/$defs/unowned"}]}}
      }
    }
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\*?\\[\\]{}\\u0000-\\u001f]).*[^/]$"
    },
    "domain_id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^\\S(?:[\\s\\S]*\\S)?$"},
    "historical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "domain_ids"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "domain_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/domain_id"}}
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "owner_domain_id"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"const": "domain"}, "owner_domain_id": {"$ref": "#/$defs/domain_id"}}
    },
    "mixed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "domain_ids"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "role": {"const": "mixed"},
        "domain_ids": {"type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/domain_id"}}
      }
    },
    "unowned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "role": {"enum": ["composition", "test_support"]}}
    }
  }
}
