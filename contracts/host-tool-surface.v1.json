{
  "schema_version": "1.0",
  "tools": [
    {
      "name": "concord_work_start",
      "description": "Use for implementation work from a default checkout, or to resume an existing item by work_id. Capture new work, reuse an active worktree, or bootstrap the missing canonical worktree. A successful claim moves the session automatically and verifies the landing; vacate returns it to the registered main; never claim from a default checkout. Resume project_id names a member Project in another repository and opens the second session or returns the launch command. A same-repository Project uses worktree_claim.",
      "args": {
        "type": "object",
        "oneOf": [
          {
            "additionalProperties": false,
            "required": ["title", "value_statement", "kind", "task", "idempotency_key"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxBytes": 256},
              "value_statement": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxBytes": 256},
              "kind": {"type": "string", "enum": ["task", "bug", "decision", "research", "other"]},
              "task": {"type": "string", "minLength": 1, "maxLength": 8192, "x-maxBytes": 8192},
              "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "priority": {"type": "integer", "minimum": -100, "maximum": 100},
              "urgency": {"type": "string", "enum": ["standard", "expedite"]},
              "tags": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
              "workflow_type_ref": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "external_ref": {"type": "string", "minLength": 1, "maxLength": 256, "x-maxBytes": 256},
              "raised_from_work_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "governing_requirements": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
              "ref": {"type": "string", "minLength": 1, "maxLength": 128},
              "defect_intake": {
                "type": "object",
                "additionalProperties": false,
                "required": ["failure_shape", "reproduction", "searched", "related_defect_ids"],
                "description": "Capture admission record for defects: required for kind bug, optional for kind research, refused for every other kind (the core enforces the kind rules and the admission decision). failure_shape is a canonical bounded slug identifier repeated on every capture of the defect class; reproduction and searched are bounded nonempty text; related_defect_ids declares distinct earlier work IDs of the same shape and may be empty; root_cause_work_id names the completed workflow.research cluster RCA a recurrent bug capture needs.",
                "properties": {
                  "failure_shape": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
                  "reproduction": {"type": "string", "minLength": 1, "maxLength": 8192, "x-maxBytes": 8192},
                  "searched": {"type": "string", "minLength": 1, "maxLength": 8192, "x-maxBytes": 8192},
                  "related_defect_ids": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}},
                  "root_cause_work_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
                }
              }
            }
          },
          {
            "additionalProperties": false,
            "required": ["work_id"],
            "properties": {
              "work_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
              "project_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
            }
          }
        ]
      }
    }
  ]
}
