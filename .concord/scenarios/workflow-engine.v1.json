      "setup": {
        "fixture_refs": {"work_item": "new", "actors": ["actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad", "actor:017389e1649c56f00f9265c121eed78cb73aca12052cefae3df35d9036a029bc"], "workflow_types": [], "evidence": ["evidence-verification", "evidence-review"], "relations": []},
