{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-utilities.schema.json",
  "title": "Concord coordinator utilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "utilities"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "utilities": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "purpose", "allowed_tools", "allowed_commands", "time_seconds_max"],
        "properties": {
          "id": {"type": "string", "enum": ["explore", "lookup", "advisor"]},
          "purpose": {"type": "string", "minLength": 1},
          "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "allowed_commands": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "time_seconds_max": {"type": "integer", "minimum": 1, "maximum": 3600}
        }
      }
    }
  }
}
