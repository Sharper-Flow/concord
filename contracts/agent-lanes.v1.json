{
  "schema_version": "1.0",
  "registry": "agent_lanes",
  "lanes": [
    {
      "id": "research",
      "purpose": "Investigate bounded questions and return source-backed findings. Dispatch through dispatch_worker when a workflow step owes recorded research findings the contract can bind.",
      "capability_class": "research",
      "capabilities": [
        "read_repository",
        "search_public_sources",
        "cite_evidence"
      ],
      "packet_schema_ref": "agent-lane-packet.v1",
      "report_schema_ref": "agent-lane-report.v1",
      "budgets": {
        "cost_usd_max": 2,
        "context_tokens_max": 32000,
        "time_seconds_max": 900
      },
      "evidence_obligations": [
        "source_citations",
        "bounded_findings",
        "uncertainties"
      ],
      "required_report_blocks": [],
      "lifecycle_states": [
        "dispatched",
        "completed",
        "failed"
      ]
    },
    {
      "id": "implement",
      "purpose": "Implement one approved bounded engineering task and report verification. Dispatch through dispatch_worker when an approved contract premise needs an isolated worktree change with evidence.",
      "capability_class": "implementation",
      "capabilities": [
        "read_repository",
        "edit_scoped_files",
        "run_tests",
        "report_evidence"
      ],
      "packet_schema_ref": "agent-lane-packet.v1",
      "report_schema_ref": "agent-lane-report.v1",
      "budgets": {
        "cost_usd_max": 4,
        "context_tokens_max": 48000,
        "time_seconds_max": 1800
      },
      "evidence_obligations": [
        "files_touched",
        "verification_commands",
        "unresolved_issues"
      ],
      "required_report_blocks": [],
      "lifecycle_states": [
        "dispatched",
        "completed",
        "failed"
      ]
    },
    {
      "id": "design",
      "purpose": "Implement visual UI and UX changes for one approved bounded task and report design evidence. Dispatch through dispatch_worker when an approved contract premise names a visual surface change.",
      "capability_class": "design",
      "capabilities": [
        "read_repository",
        "edit_scoped_files",
        "run_targeted_checks",
        "report_evidence"
      ],
      "packet_schema_ref": "agent-lane-packet.v1",
      "report_schema_ref": "agent-lane-report.v1",
      "budgets": {
        "cost_usd_max": 4,
        "context_tokens_max": 48000,
        "time_seconds_max": 1800
      },
      "evidence_obligations": [
        "files_touched",
        "verification_commands",
        "visual_artifacts",
        "unresolved_issues"
      ],
      "required_report_blocks": [],
      "lifecycle_states": [
        "dispatched",
        "completed",
        "failed"
      ]
    },
    {
      "id": "review",
      "purpose": "Review a bounded change against its contract and acceptance evidence. Dispatch through dispatch_worker when a delivered change owes a severity-rated review before completion.",
      "capability_class": "review",
      "capabilities": [
        "read_repository",
        "edit_scoped_files",
        "inspect_diff",
        "run_targeted_checks",
        "report_findings"
      ],
      "packet_schema_ref": "agent-lane-packet.v1",
      "report_schema_ref": "agent-lane-report.v1",
      "budgets": {
        "cost_usd_max": 2.5,
        "context_tokens_max": 40000,
        "time_seconds_max": 1200
      },
      "evidence_obligations": [
        "contract_findings",
        "severity",
        "verification_commands"
      ],
      "required_report_blocks": [
        "review"
      ],
      "lifecycle_states": [
        "dispatched",
        "completed",
        "failed"
      ]
    },
    {
      "id": "verify",
      "purpose": "Run independent verification and return deterministic pass or failure evidence. Dispatch through dispatch_worker when a contract's outcome predicates need execution evidence a non-author produced.",
      "capability_class": "verification",
      "capabilities": [
        "read_repository",
        "run_tests",
        "run_validators",
        "report_evidence"
      ],
      "packet_schema_ref": "agent-lane-packet.v1",
      "report_schema_ref": "agent-lane-report.v1",
      "budgets": {
        "cost_usd_max": 3,
        "context_tokens_max": 40000,
        "time_seconds_max": 1500
      },
      "evidence_obligations": [
        "commands",
        "exit_codes",
        "failure_classification"
      ],
      "required_report_blocks": [],
      "lifecycle_states": [
        "dispatched",
        "completed",
        "failed"
      ]
    }
  ],
  "utilities": [
    {
      "id": "explore",
      "purpose": "Investigate one bounded repository question that requires discovering and following evidence paths. Return a right-sized, source-backed briefing. Use direct tools for targeted retrieval of known files, symbols, or strings; never use this utility for external facts.",
      "allowed_tools": [
        "bash",
        "read",
        "glob",
        "grep",
        "execute"
      ],
      "allowed_commands": [
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "git ls-files *",
        "git rev-parse *"
      ],
      "time_seconds_max": 600
    },
    {
      "id": "lookup",
      "purpose": "Conduct a bounded adaptive external investigation and return source-backed findings. Use when answering requires discovering and following evidence paths or comparing sources; use direct tools for targeted retrieval of a known URL or API detail. Never for repository-internal questions.",
      "allowed_tools": [
        "webfetch",
        "execute"
      ],
      "allowed_commands": [],
      "time_seconds_max": 600
    },
    {
      "id": "advisor",
      "purpose": "Give an independent reasoned opinion on a bounded problem and cite the evidence for it. Use when a coordinator wants a second opinion reached without seeing the caller's own conclusion.",
      "allowed_tools": [
        "bash",
        "read",
        "glob",
        "grep",
        "execute"
      ],
      "allowed_commands": [
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "git ls-files *",
        "git rev-parse *"
      ],
      "time_seconds_max": 600
    }
  ]
}
