{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/worker-scope.schema.json",
  "title": "Concord worker scope contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry", "version", "summary", "premise", "assignments"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry": {"const": "worker_scope"},
    "version": {"const": 1},
    "summary": {"type": "string", "minLength": 2, "maxLength": 1024},
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["single_assigned_result", "parent_explicit_sequential"],
      "properties": {
        "single_assigned_result": {"const": "Each worker attempt completes only its assigned result."},
        "parent_explicit_sequential": {"const": "The parent workflow keeps other required results explicit and can dispatch sequential bounded attempts."}
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/assignment"}
    }
  },
  "$defs": {
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "result"],
      "properties": {
        "lane_id": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z][a-z0-9_-]*$"},
        "result": {"$ref": "#/$defs/result_obligation"}
      }
    },
    "result_obligation": {
      "description": "The closed evidence obligation whose discharge evidences the lane's completed assigned result. The enum must equal contracts/agent-lanes.schema.json #/$defs/evidence_obligation so the two vocabularies cannot drift; scripts/check-worker-scope-contract.py enforces that equality.",
      "enum": ["bounded_findings", "commands", "contract_findings", "exit_codes", "failure_classification", "files_touched", "severity", "source_citations", "uncertainties", "unresolved_issues", "verification_commands", "visual_artifacts"]
    }
  }
}
