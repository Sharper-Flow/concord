{
  "schema_version": "1.0",
  "project": "concord",
  "domain_shape": {
    "required_checks": ["go-test-race"]
  },
  "tools": [
    {
      "id": "local-test-plan",
      "purpose": "Inspect a local command's selection and admission without test execution or discovery.",
      "invocation": "bin/oc-test plan broad -- go test ./internal/store",
      "tier": "fast",
      "cost_hint": "Parses command arguments only; no dependency scan or test subprocess.",
      "config_path": "scripts/local-test-plan.py",
      "notes": "TESTING.md owns risk-based selection recipes. This is not an exhaustive impact selector or named-test result proof. Use bin/oc-test broad for suites, shards and unknown command shapes."
    },
    {
      "id": "bin-oc-test",
      "purpose": "Local ten-process conformance throttle.",
      "invocation": "bin/oc-test conformance",
      "tier": "slow",
      "cost_hint": "Expected to complete in minutes.",
      "config_path": "bin/oc-test",
      "notes": "Sanctioned local entry for the ten-process SQLite conformance harness."
    },
    {
      "id": "go-test-race",
      "purpose": "Race instrumentation for the five concurrent store tests in required verify-race.",
      "invocation": "bin/oc-test targeted -- go test -race -timeout=15m -run '^(TestOpenConcurrentlyInitializesOneDatabase|TestAppendEventConcurrentEquivalentAppends|TestAppendEventConcurrentDivergentAppends|TestConcurrentWorkflowActorAppendsUseTheSingleWriter|TestWorkflowLawRevisionCutoverCommitsBeforeCrossConnectionAcceptance)$' ./internal/store",
      "tier": "slow",
      "cost_hint": "The command timeout is 15 minutes.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "go-event-log-continuity",
      "purpose": "Event-log reference assertions and the continuity reclaim witness in required verify-go.",
      "invocation": "bin/oc-test targeted -- go test -count=1 -timeout=300s -run '^(TestEventLogReferences|TestEventLogReferencePropertiesBite|TestSessionVacateReclaimOccupancyGateCorpus)$' ./internal/store",
      "tier": "standard",
      "automation_path": ".github/workflows/ci.yml",
      "coverage": [
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-session-vacate-then-reclaim-passes-occupancy-gate"},
          "owner": {"kind": "go_test", "value": "internal/store.TestSessionVacateReclaimOccupancyGateCorpus"}
        }
      ]
    },
    {
      "id": "go-vet",
      "purpose": "Standard Go static analysis over every package.",
      "invocation": "go vet ./...",
      "tier": "fast",
      "cost_hint": "Expected to complete in seconds.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "gofmt",
      "purpose": "Go source formatting check; empty output means formatted.",
      "invocation": "gofmt -l .",
      "tier": "fast",
      "cost_hint": "Expected to complete in seconds.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "govulncheck",
      "purpose": "Go dependency vulnerability scan in required verify-go against the pinned govulncheck version.",
      "invocation": "go run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...",
      "tier": "standard",
      "cost_hint": "Expected to complete in minutes.",
      "automation_path": ".github/workflows/ci.yml",
      "notes": "The version pin is load-bearing; CI rejects an unpinned run."
    },
    {
      "id": "lefthook-preflight",
      "purpose": "File-selected Lefthook pre-push gates; the installed hook runs them on every push.",
      "invocation": "bin/oc-test preflight",
      "tier": "standard",
      "cost_hint": "Cheaper than the smoke tier; gates whose globs match no pushed file are skipped.",
      "config_path": "lefthook.yml",
      "automation_path": ".github/workflows/ci.yml",
      "notes": "Every push uses the installed shared hook; CONTRIBUTING.md owns clone setup and failure recovery. This invocation diagnoses the same gates manually, not a full verify or an exhaustive test mapping; CI stays the verification owner. Parity is enforced by scripts/check-pre-push.py and the pinned upstream release is v2.1.14."
    },
    {
      "id": "adapter-continuity",
      "purpose": "Exercise the adapter continuity corpus assertions.",
      "invocation": "bun test adapter/opencode/continuity_hook.test.ts",
      "tier": "standard",
      "automation_path": ".github/workflows/ci.yml",
      "coverage": [
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-byte-stable-across-turns"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-byte-stable-across-turns"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-state-change-replaces-block"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-state-change-replaces-block"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-failure-is-absence"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-failure-is-absence"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-ttl-gates-spawn"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-ttl-gates-spawn"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-work-start-retarget"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-work-start-retarget"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-lane-leak-absent"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-lane-leak-absent"}
        },
        {
          "anchor": {"kind": "scenario", "value": "adapter-continuity-post-boundary-re-pin"},
          "owner": {"kind": "adapter_test", "value": "adapter/opencode/continuity_hook.test.ts#adapter-continuity-post-boundary-re-pin"}
        }
      ]
    },
    {
      "id": "repo-validators",
      "purpose": "Repository contract drift checks; check-json.py chains the validator suite.",
      "invocation": "python3 scripts/check-json.py",
      "tier": "fast",
      "cost_hint": "Expected to complete in seconds.",
      "automation_path": ".github/workflows/ci.yml",
      "notes": "The AGENTS.md Where-to-look table maps each validator to the question it answers."
    }
  ]
}
