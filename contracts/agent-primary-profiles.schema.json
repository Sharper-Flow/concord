{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-primary-profiles.schema.json",
  "title": "Concord named primary and native step-helper profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry", "profiles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry": {"const": "agent_primary_profiles"},
    "profiles": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/profile"}}
  },
  "$defs": {
    "agent_id": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$"},
    "action": {"enum": ["allow", "ask", "deny"]},
    "pattern_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "action"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1, "maxLength": 128},
          "action": {"$ref": "#/$defs/action"}
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "role_source", "tools", "bash", "task", "denied_concord_tools"],
      "properties": {
        "id": {"$ref": "#/$defs/agent_id"},
        "mode": {"enum": ["primary", "subagent"]},
        "description": {"type": "string", "minLength": 16, "maxLength": 512},
        "role_source": {"type": "string", "minLength": 4, "maxLength": 256, "pattern": "^\\.concord/roles/[a-z][a-z0-9-]*\\.md$"},
        "tools": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/action"}
        },
        "edit": {"$ref": "#/$defs/pattern_rules"},
        "bash": {"$ref": "#/$defs/pattern_rules"},
        "task": {"$ref": "#/$defs/pattern_rules"},
        "denied_concord_tools": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^concord_[a-z_]+$"}
        }
      }
    }
  }
}
