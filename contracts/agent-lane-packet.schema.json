{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/agent-lane-packet.schema.json",
  "title": "Concord agent lane packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "lane_id",
    "lane_version",
    "lane_digest",
    "work_id",
    "step_id",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128
    },
    "lane_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "lane_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "lane_digest": {
      "type": "string",
      "minLength": 71,
      "maxLength": 71,
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "work_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "binding"
      ],
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "binding": {
          "$ref": "#/$defs/lane_packet_binding"
        },
        "context": {
          "type": "string",
          "minLength": 0,
          "maxLength": 16384
        },
        "correction": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "disposition",
            "attempt_count",
            "attempt_limit",
            "escalated",
            "diagnosis",
            "strategy",
            "predicate_ids",
            "evidence_refs"
          ],
          "properties": {
            "disposition": {
              "type": "string",
              "enum": [
                "failed",
                "rejected",
                "verification"
              ]
            },
            "attempt_count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "attempt_limit": {
              "const": 3
            },
            "escalated": {
              "type": "boolean"
            },
            "diagnosis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "strategy": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "failure_kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "failure_detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "predicate_ids": {
              "type": "array",
              "minItems": 0,
              "maxItems": 8,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "evidence_refs": {
              "type": "array",
              "minItems": 0,
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              }
            }
          }
        },
        "constraints": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        },
        "outcome_predicates": {
          "$ref": "#/$defs/lane_outcome_predicates"
        }
      }
    }
  },
  "$defs": {
    "lane_packet_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective_source",
        "work_version",
        "contract_version",
        "assigned_result"
      ],
      "properties": {
        "objective_source": {
          "type": "string",
          "enum": [
            "contract_premise",
            "work_question"
          ],
          "description": "Where inputs.task came from: contract_premise is the approved contract premise carried verbatim; work_question is the recorded work question carried before contract approval."
        },
        "work_version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "The applicable contract version, or null when no contract applies."
        },
        "assigned_result": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "The one evidence obligation whose discharge completes this attempt, derived from the registered lane."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "objective_source": {
                "const": "contract_premise"
              }
            },
            "required": [
              "objective_source"
            ]
          },
          "then": {
            "properties": {
              "contract_version": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "objective_source": {
                "const": "work_question"
              }
            },
            "required": [
              "objective_source"
            ]
          },
          "then": {
            "properties": {
              "contract_version": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "lane_outcome_predicates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/lane_outcome_predicate"
      }
    },
    "lane_outcome_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predicate_id",
        "ordinal",
        "outcome_kind",
        "outcome_payload"
      ],
      "properties": {
        "predicate_id": {
          "type": "string",
          "minLength": 11,
          "maxLength": 128,
          "pattern": "^predicate:[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "description": "The store refuses a predicate_id without the \"predicate:\" prefix. Write ids in the form \"predicate:<name>\"."
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 7
        },
        "outcome_kind": {
          "type": "string",
          "enum": [
            "exists",
            "absent",
            "outcome",
            "check"
          ]
        },
        "outcome_payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "exists",
                "absent",
                "outcome",
                "check"
              ]
            },
            "surface": {
              "$ref": "#/$defs/lane_predicate_surface"
            },
            "subjects": {
              "$ref": "#/$defs/lane_predicate_subjects"
            },
            "distinguish_from": {
              "$ref": "#/$defs/lane_predicate_distinguish_from"
            },
            "allowed": {
              "$ref": "#/$defs/lane_predicate_allowed"
            },
            "decision_record": {
              "$ref": "#/$defs/lane_predicate_decision_record"
            },
            "check_ref": {
              "$ref": "#/$defs/lane_predicate_check_ref"
            },
            "immutable_subject_ref": {
              "$ref": "#/$defs/lane_predicate_immutable_subject_ref"
            },
            "expected_result": {
              "$ref": "#/$defs/lane_predicate_expected_result"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "exists"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_exists"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "absent"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_absent"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "outcome"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_outcome"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome_kind": {
                "const": "check"
              }
            },
            "required": [
              "outcome_kind"
            ]
          },
          "then": {
            "properties": {
              "outcome_payload": {
                "$ref": "#/$defs/lane_predicate_payload_check"
              }
            }
          }
        }
      ]
    },
    "lane_predicate_surface": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:/-]{1,127}$"
    },
    "lane_predicate_subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 128,
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{1,127}$"
      }
    },
    "lane_predicate_payload_exists": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "surface",
        "subjects"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "exists"
        },
        "surface": {
          "$ref": "#/$defs/lane_predicate_surface"
        },
        "subjects": {
          "$ref": "#/$defs/lane_predicate_subjects"
        }
      }
    },
    "lane_predicate_payload_absent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "surface",
        "subjects",
        "distinguish_from"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "absent"
        },
        "surface": {
          "$ref": "#/$defs/lane_predicate_surface"
        },
        "subjects": {
          "$ref": "#/$defs/lane_predicate_subjects"
        },
        "distinguish_from": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "archived",
              "relocated",
              "renamed",
              "disabled"
            ]
          }
        }
      }
    },
    "lane_predicate_payload_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "allowed"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "outcome"
        },
        "allowed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "no_change",
              "accepted_decision",
              "insufficient_evidence",
              "resolved",
              "remediated",
              "report_recorded",
              "completed",
              "operator_defined"
            ]
          }
        },
        "decision_record": {
          "$ref": "#/$defs/lane_predicate_decision_record"
        }
      }
    },
    "lane_predicate_decision_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "options_considered",
        "decision",
        "rationale",
        "consequences",
        "inputs",
        "poc_findings",
        "supersedes",
        "superseded_by",
        "unknowns",
        "required_to_decide",
        "reviewer_actor_ref",
        "operator_approval_ref"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "options_considered": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "decision": {
          "type": "string",
          "enum": [
            "accepted_decision",
            "insufficient_evidence"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "consequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          }
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "poc_findings": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "supersedes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        },
        "unknowns": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        },
        "required_to_decide": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "minItems": 0
        },
        "reviewer_actor_ref": {
          "type": "string",
          "minLength": 70,
          "maxLength": 70,
          "pattern": "^actor:[0-9a-f]{64}$"
        },
        "operator_approval_ref": {
          "type": "string",
          "minLength": 9,
          "maxLength": 136,
          "pattern": "^approval:[a-z0-9][a-z0-9_.:/-]{1,127}$"
        }
      }
    },
    "lane_predicate_payload_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "check_ref",
        "immutable_subject_ref",
        "expected_result"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "const": "check"
        },
        "check_ref": {
          "type": "string",
          "minLength": 7,
          "maxLength": 134,
          "pattern": "^check:[a-z][a-z0-9_.:/-]{1,127}$"
        },
        "immutable_subject_ref": {
          "type": "string",
          "minLength": 2,
          "maxLength": 256,
          "pattern": "^[a-z][a-z0-9_.:/-]{1,255}$"
        },
        "expected_result": {
          "type": "string",
          "enum": [
            "true",
            "false",
            "pass",
            "fail",
            "present",
            "absent",
            "healthy",
            "unhealthy",
            "accepted",
            "rejected"
          ]
        }
      }
    },
    "lane_predicate_distinguish_from": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "archived",
          "relocated",
          "renamed",
          "disabled"
        ]
      }
    },
    "lane_predicate_allowed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "no_change",
          "accepted_decision",
          "insufficient_evidence",
          "resolved",
          "remediated",
          "report_recorded",
          "completed",
          "operator_defined"
        ]
      }
    },
    "lane_predicate_check_ref": {
      "type": "string",
      "minLength": 7,
      "maxLength": 134,
      "pattern": "^check:[a-z][a-z0-9_.:/-]{1,127}$"
    },
    "lane_predicate_immutable_subject_ref": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9_.:/-]{1,255}$"
    },
    "lane_predicate_expected_result": {
      "type": "string",
      "enum": [
        "true",
        "false",
        "pass",
        "fail",
        "present",
        "absent",
        "healthy",
        "unhealthy",
        "accepted",
        "rejected"
      ]
    }
  }
}
