#!/usr/bin/env bash
#
# Repository-local verification throttle wrapper.
#
# Tiers:
#   smoke          Go packages CI tests without shards, adapter tests, and
#                  JSON/law validation.
#   targeted       Bounded command shapes checked without executing discovery.
#   broad          Explicit arbitrary command under full host admission.
#   store-shard    One CI shard of the local store suite under full admission;
#                  run each shard index as its own invocation, so every shard
#                  is one admission and the slot is released between shards.
#   conformance    Gated ten-process correctness conformance harness.
#   preflight      Lefthook pre-push gates (lefthook.yml), pinned to v2.1.14.
#   preflight-gate One pre-push gate command under smoke admission; the gates
#                  in lefthook.yml run through this tier, so a normal push
#                  enters host admission without anyone invoking this wrapper
#                  by hand.
#
# Smoke leaves out the packages CI splits into shard jobs (internal/store,
# internal/agent, and cmd/concord). Its Go step is CI's "Test every package
# without its own shard job" command, and scripts/test-oc-test.py fails when the
# two differ. The unsharded store suite cannot finish inside one 15-minute
# alarm on a loaded host, so the declared local store route is one shard at a
# time. To test one shard locally, run CI's selection for it, for example,
# shard 1 of 7:
#
#   bin/oc-test store-shard 1 7
#
# The tier runs the same scripts/go-test-shard.py selection CI's shard jobs
# run, with the `go test -list` discovery inside admission. A shard is a
# CI-placement tool, not a default local coverage choice; TESTING.md owns when
# to run one.
#
# Host admission control is provided by `oc-test-gate` when it is installed.
# Smoke uses smoke admission; targeted uses ungated targeted admission; broad,
# store-shard, and conformance use full admission; the pre-push gates use smoke admission
# through the preflight-gate tier, because they vet, build, lint, and compile
# every package, which is heavy on a shared host when several worktrees push
# at once. Each admitted gate rejoins the queue per gate, so a contended slot
# lengthens a push by about one full queue wait per matched gate. The
# preflight tier passes no admission class of its own: its gates admit
# themselves, because one wrapper around the whole battery would hold the
# shared admission slot, and every gate inside it would then wait on that
# held slot. When `oc-test-gate` is missing, heavy tiers refuse;
# preflight-gate instead runs its one gate natively with a warning, because
# a normal push must not lose a gate on a host that has no admission route
# to enter. The continuous-integration workflow does not use this wrapper; it
# calls the same underlying commands natively so its behavior stays
# deterministic.
#
# The tier above and the gate's admission class are separate vocabularies. A
# tier names a workload this repository owns. An admission class names a
# throttling behavior the host tool owns, and `oc-test-gate` accepts only
# `targeted`, `smoke`, and `full`. Passing a tier name where a class belongs
# makes the gate exit 2 with `unknown tier`.
#
# Every tier runs under a kernel file-size limit (RLIMIT_FSIZE), set as both
# the soft and the hard limit so no test process can raise it. The default is
# 1024 MiB per file. The kernel stops the file growing past it and sends the
# writer SIGXFSZ, which kills it unless the writer handles or ignores it. The
# tier reports its command's exit status, 153 when SIGXFSZ killed that command.
# Raise the limit for one run, never to unlimited, with OC_TEST_MAX_FILE_MIB:
#
#   OC_TEST_MAX_FILE_MIB=4096 bin/oc-test targeted -- <command>
#
# A stricter hard limit inherited from the caller is kept.

set -euo pipefail
# POSIX mode counts `ulimit -f` in 512-byte blocks; the limit below is KiB.
set +o posix

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

usage() {
  cat >&2 <<'USAGE'
Usage: bin/oc-test smoke | targeted -- <command> [args...] | broad -- <command> [args...] | store-shard <i> <n> | preflight-gate -- <command> [args...] | plan <targeted|broad> -- <command> [args...] | read-go ARTIFACT_DIR [package=TestName ...] | conformance | preflight

  smoke          Go packages CI tests without shards, adapter suite, and JSON/law validation under host admission control
  targeted       Go literal fragments/anchored names, adapter test files, or one Python check/test script with native arguments
  broad          arbitrary caller command under full host admission (including suites/shards)
  store-shard    one CI shard of the local store suite under full host admission; run each index i=1..n as its own invocation
  preflight-gate one pre-push gate command under smoke admission; runs natively, with a warning, when oc-test-gate is missing
  plan         print command/admission/selection JSON without discovery or execution
  read-go      compare named expectations with retained shared Go producer artifacts
  conformance  ten-process SQLite correctness harness under host admission control
  preflight    Lefthook pre-push gates from lefthook.yml; the gates admit themselves

Every tier limits each written file to OC_TEST_MAX_FILE_MIB (default 1024) MiB.
USAGE
  exit 64
}

max_file_mib="${OC_TEST_MAX_FILE_MIB:-1024}"
if [[ ! "$max_file_mib" =~ ^[1-9][0-9]{0,6}$ ]]; then
  printf 'bin/oc-test: OC_TEST_MAX_FILE_MIB must be a whole number of MiB from 1 to 9999999, got %q\n' "$max_file_mib" >&2
  exit 64
fi

# Apply the per-file limit to this shell and everything it starts.
file_limit_kib=$((max_file_mib * 1024))
limit_file_size() {
  local hard
  hard="$(ulimit -H -f)"
  if [[ "$hard" != unlimited && "$hard" -lt "$file_limit_kib" ]]; then
    file_limit_kib="$hard"
  fi
  ulimit -f "$file_limit_kib"
}

# Policy when oc-test-gate is missing from PATH: `refuse` for heavy tiers,
# `run` for a pre-push gate, which must keep running on a host that has no
# admission route to enter.
run_tier_missing=refuse

# Run a workload, wrapped in host admission control when it is available.
# The first argument is the tier this wrapper reports. The second is the
# admission class the host gate understands, or `none` for a workload whose
# commands admit themselves through this wrapper (the preflight battery);
# `none` is wrapper vocabulary, never an argument to the host gate.
run_tier() {
  local tier="$1"
  local admission_class="$2"
  shift 2

  local -a gate=()
  if [[ "$admission_class" == none ]]; then
    :
  elif command -v oc-test-gate >/dev/null 2>&1; then
    gate=(oc-test-gate "$admission_class" --)
  else
    if [[ "$admission_class" != targeted && "$run_tier_missing" == refuse ]]; then
      printf 'bin/oc-test: %s requires oc-test-gate on PATH; refusing an unthrottled heavy workload.\n' "$tier" >&2
      exit 69
    fi
    printf 'bin/oc-test: oc-test-gate not found on PATH; running the %s tier unthrottled.\n' "$tier" >&2
    printf 'bin/oc-test: concurrent runs on this machine are not admission-controlled.\n' >&2
  fi

  limit_file_size
  printf 'START %s\n' "$tier"
  local rc=0
  if [[ ${#gate[@]} -gt 0 && "$admission_class" != targeted ]]; then
    printf 'WAIT admission: %s (shared heavy-test slot)\n' "$tier"
  fi
  set +e
  if [[ ${#gate[@]} -gt 0 ]]; then
    # A non-interactive shell starts an asynchronous command with SIGINT and
    # SIGQUIT ignored and stdin from /dev/null; restore both so the gate can
    # trap INT and the workload keeps the caller's stdin.
    ( trap - INT QUIT; exec "${gate[@]}" "$@" ) <&0 &
    local child=$!
    # Forward cancellation to the existing host owner; it terminates its own
    # workload subtree. Do not build another descendant walker here.
    trap 'kill -TERM "$child" 2>/dev/null || true; wait "$child"; exit 143' TERM
    trap 'kill -INT "$child" 2>/dev/null || true; wait "$child"; exit 130' INT
    wait "$child"
    rc=$?
    trap - TERM INT
  else
    "$@"
    rc=$?
  fi
  set -e
  if [[ "$rc" -eq 0 ]]; then
    printf 'PASS %s (process exit 0; named test execution not verified)\n' "$tier"
  else
    printf 'FAIL %s (exit %s)\n' "$tier" "$rc" >&2
    if [[ "$rc" -eq 153 ]]; then
      printf 'bin/oc-test: a process was killed by SIGXFSZ: it wrote past the %s KiB per-file limit (OC_TEST_MAX_FILE_MIB).\n' "$file_limit_kib" >&2
    fi
  fi
  exit "$rc"
}

tier="${1:-}"
[[ -n "$tier" ]] || usage
shift || true
# `targeted` accepts an optional `--` separator before its command. Tiers
# that take no arguments must refuse it, so remember whether one was eaten.
consumed_separator=0
if [[ "${1:-}" == "--" ]]; then
  consumed_separator=1
  shift
fi

case "$tier" in
  smoke)
    [[ $# -eq 0 ]] || usage
    run_tier smoke smoke bash -euo pipefail -c '
      go test -timeout=15m $(go list ./... | grep -v -x -F -e github.com/sharper-flow/concord/internal/store -e github.com/sharper-flow/concord/internal/agent -e github.com/sharper-flow/concord/cmd/concord)
      env -u CONCORD_SELECTED_PRODUCT_ID bun test adapter/opencode/
      env -u CONCORD_SELECTED_PRODUCT_ID CONCORD_REQUIRE_BUN=1 python3 scripts/check-json.py --adapter-tests-external
    '
    ;;
  targeted)
    [[ $# -gt 0 ]] || usage
    python3 "$repo_root/scripts/local-test-plan.py" targeted -- "$@"
    run_tier targeted targeted "$@"
    ;;
  broad)
    [[ $# -gt 0 ]] || usage
    run_tier broad full "$@"
    ;;
  store-shard)
    [[ $# -eq 2 && "$consumed_separator" -eq 0 ]] || usage
    if [[ ! "$1" =~ ^[0-9]+$ || ! "$2" =~ ^[0-9]+$ ]] || (( 10#"$1" < 1 || 10#"$2" < 1 || 10#"$1" > 10#"$2" )); then
      printf 'bin/oc-test: store-shard needs a shard index and count with 1 <= i <= n, got %s %s\n' "$1" "$2" >&2
      exit 64
    fi
    # CI's shard selection with discovery inside admission: go-test-shard.py
    # runs `go test -list` under the same admission as the test run. The shard
    # numbers travel as bash -c positional parameters, so the command string
    # is fixed and no caller text is interpolated into it. The selector's
    # pattern is assigned first: an empty pattern would select the whole
    # package, and under `set -e` a failed assignment stops the run instead.
    run_tier store-shard full bash -euo pipefail -c \
      'pattern="$(python3 scripts/go-test-shard.py ./internal/store "$1" "$2")"; go test -timeout=15m -run "$pattern" ./internal/store' \
      store-shard "$1" "$2"
    ;;
  plan)
    [[ $# -gt 1 ]] || usage
    exec python3 "$repo_root/scripts/local-test-plan.py" --json "$@"
    ;;
  read-go)
    [[ $# -gt 0 ]] || usage
    exec python3 "$repo_root/scripts/read-local-go-results.py" "$@"
    ;;
  conformance)
    [[ $# -eq 0 ]] || usage
    run_tier conformance full env CONCORD_CONFORMANCE_LONG=1 go test -count=1 -run '^TestTenProcessConformance$' ./internal/store -v
    ;;
  preflight)
    [[ $# -eq 0 && "$consumed_separator" -eq 0 ]] || usage
    # The pinned lefthook release runs the pre-push gates from lefthook.yml.
    # Prefer an installed binary; otherwise run the pinned module version.
    # Never install or mutate git hooks from here: lefthook.yml sets
    # no_auto_install, and installing hooks is a one-time contributor step
    # documented in CONTRIBUTING.md.
    # No admission here: every gate command in lefthook.yml admits itself
    # through the preflight-gate tier, because one wrapper around the whole
    # battery would hold the shared admission slot, and every gate inside it
    # would then wait on that held slot.
    if command -v lefthook >/dev/null 2>&1; then
      run_tier preflight none lefthook run pre-push
    else
      printf 'bin/oc-test: lefthook binary not found on PATH; using the pinned module.\n' >&2
      run_tier preflight none go run github.com/evilmartians/lefthook/v2@v2.1.14 run pre-push
    fi
    ;;
  preflight-gate)
    [[ $# -gt 0 ]] || usage
    # One pre-push gate command, admitted by the host gate. A missing host
    # gate must not strip the gate from a normal push: run it natively.
    run_tier_missing=run
    run_tier preflight-gate smoke "$@"
    ;;
  *)
    usage
    ;;
esac
