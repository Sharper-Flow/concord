    {
      "id": "local-test-plan",
      "purpose": "Inspect a local command's selection and admission without test execution or discovery.",
      "invocation": "bin/oc-test plan broad -- go test ./internal/store",
      "tier": "fast",
      "cost_hint": "Parses command arguments only; no dependency scan or test subprocess.",
      "config_path": "scripts/local-test-plan.py",
      "notes": "TESTING.md owns risk-based selection recipes. This is not an exhaustive impact selector or named-test result proof. Use bin/oc-test broad for suites, shards and unknown command shapes."
    },
    {
      "id": "bin-oc-test",
      "purpose": "Local ten-process conformance throttle.",
      "invocation": "bin/oc-test conformance",
      "tier": "slow",
      "cost_hint": "Expected to complete in minutes.",
      "config_path": "bin/oc-test",
      "notes": "Sanctioned local entry for the ten-process SQLite conformance harness."
    },
    {
      "id": "go-test-race",
      "purpose": "The Go test suite with the race detector.",
      "invocation": "bin/oc-test broad -- go test -race -timeout=20m ./...",
      "tier": "slow",
      "cost_hint": "The command timeout is 20 minutes.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "go-vet",
      "purpose": "Standard Go static analysis over every package.",
      "invocation": "go vet ./...",
      "tier": "fast",
      "cost_hint": "Expected to complete in seconds.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "gofmt",
      "purpose": "Go source formatting check; empty output means formatted.",
      "invocation": "gofmt -l .",
      "tier": "fast",
      "cost_hint": "Expected to complete in seconds.",
      "automation_path": ".github/workflows/ci.yml"
    },
    {
      "id": "govulncheck",
      "purpose": "Go vulnerability scan against the pinned govulncheck version.",
      "invocation": "go run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...",
      "tier": "standard",
      "cost_hint": "Expected to complete in minutes.",
      "automation_path": ".github/workflows/ci.yml",
      "notes": "The version pin is load-bearing; CI rejects an unpinned run."
    },
