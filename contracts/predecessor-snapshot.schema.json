{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/predecessor-snapshot.schema.json",
  "title": "Concord predecessor snapshot v1",
  "description": "Migration input produced by a host-side harvest of the predecessor's sanctioned read surface. Concord owns the contract and validates it fail-closed; this slice emits an enumeration summary and writes nothing to the store.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "captured_at",
    "producer",
    "source_system",
    "projects"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "schema_version": {
      "const": 1
    },
    "captured_at": {
      "type": "string",
      "format": "date-time",
      "minLength": 1,
      "maxLength": 64
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source_system": {
      "const": "advance"
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/project"
      }
    }
  },
  "$defs": {
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "locator",
        "archived_changes",
        "closed_changes",
        "active_changes",
        "wisdom_entries",
        "reflections"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "archived_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "closed_changes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "active_changes": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/activeChange"
          }
        },
        "wisdom_entries": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/wisdomEntry"
          }
        },
        "reflections": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/reflection"
          }
        }
      }
    },
    "activeChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "change_id",
        "summary",
        "status",
        "completed_gates",
        "tasks_total",
        "tasks_done",
        "updated_at"
      ],
      "properties": {
        "change_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "completed_gates": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "tasks_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "tasks_done": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "updated_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "wisdomEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "content",
        "change_id",
        "promoted",
        "recorded_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        },
        "change_id": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "promoted": {
          "type": "boolean"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "reflection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "change_id",
        "recorded_at",
        "friction_count",
        "suggestion_count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "change_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time",
          "minLength": 1,
          "maxLength": 64
        },
        "friction_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "suggestion_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    }
  }
}