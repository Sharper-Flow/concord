        "operation": {"op_id": "wf01-capture-late-outcome-operation"}
      },
      "observations": {"expected_reads": [
        {"target": "state", "path": "work.lifecycle", "op": "eq", "value": "needed"},
        {"target": "state", "path": "new.current_step", "op": "eq", "value": "intake"}
      ]}
    },
    {
