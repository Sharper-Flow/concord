  "utilities": [
    {
      "id": "explore",
      "version": 1,
      "purpose": "Inspect a repository and return bounded source-backed findings.",
      "allowed_tools": ["bash", "read", "glob", "grep", "execute"],
      "allowed_commands": [
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "git ls-files *",
        "git rev-parse *"
      ],
      "time_seconds_max": 600
    },
    {
      "id": "lookup",
      "version": 1,
      "purpose": "Research bounded external questions and return source-backed findings.",
      "allowed_tools": ["webfetch", "execute"],
      "allowed_commands": [],
      "time_seconds_max": 600
    },
    {
      "id": "advisor",
      "version": 1,
      "purpose": "Give an independent reasoned opinion on a bounded problem and cite the evidence for it.",
      "allowed_tools": ["bash", "read", "glob", "grep", "execute"],
      "allowed_commands": [
        "git diff *",
        "git log *",
        "git show *",
        "git status *",
        "git ls-files *",
