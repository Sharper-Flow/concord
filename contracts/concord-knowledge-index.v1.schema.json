{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/concord-knowledge-index.v1.schema.json",
  "title": "Concord durable knowledge index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "supported_kinds",
    "indexed_kinds",
    "domain_registry",
    "records"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.2",
        "1.3"
      ]
    },
    "supported_kinds": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "work_note",
          "constitution",
          "decision",
          "spec",
          "lesson",
          "reference",
          "research"
        ]
      }
    },
    "indexed_kinds": {
      "type": "array",
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "enum": [
          "work_note",
          "constitution",
          "decision",
          "spec",
          "lesson",
          "reference",
          "research"
        ]
      }
    },
    "domain_registry": {
      "description": "The designated knowledge home's Product Domain registry.",
      "$ref": "#/$defs/domainRegistry"
    },
    "knowledge_roots": {
      "$ref": "#/$defs/knowledgeRoots"
    },
    "exclusions": {
      "$ref": "#/$defs/knowledgeExclusions"
    },
    "operator_overrides": {
      "$ref": "#/$defs/operatorOverrides"
    },
    "dispositions": {
      "$ref": "#/$defs/dispositions"
    },
    "records": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/recordV12"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "description": "CD-0159 D3: the standing of a law record, beside status. legislated_by and contract_version name the operator-approved work contract that fixed the legislated standing; they are required exactly when the tier is legislated.",
      "required": [
        "tier"
      ],
      "properties": {
        "tier": {
          "type": "string",
          "enum": [
            "legislated",
            "derived"
          ]
        },
        "legislated_by": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^work-[0-9a-f]{8,64}$"
        },
        "contract_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tier": {
                "const": "legislated"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "required": [
              "legislated_by",
              "contract_version"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "tier": {
                "const": "derived"
              }
            },
            "required": [
              "tier"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "legislated_by"
                  ]
                },
                {
                  "required": [
                    "contract_version"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "evidencePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?![\\s\\S]*\\.\\.)[\\s\\S]+$"
    },
    "ids": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "scopeCommon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "product_ids",
        "project_ids",
        "tag_ids"
      ],
      "properties": {
        "mode": {
          "enum": [
            "home",
            "explicit"
          ]
        },
        "product_ids": {
          "$ref": "#/$defs/ids"
        },
        "project_ids": {
          "$ref": "#/$defs/ids"
        },
        "domain_ids": {
          "$ref": "#/$defs/ids"
        },
        "tag_ids": {
          "$ref": "#/$defs/ids"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "home"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "product_ids": {
                "maxItems": 0
              },
              "project_ids": {
                "maxItems": 0
              },
              "tag_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "scopeV12": {
      "allOf": [
        {
          "$ref": "#/$defs/scopeCommon"
        },
        {
          "type": "object",
          "required": [
            "domain_ids"
          ],
          "properties": {
            "domain_ids": {
              "$ref": "#/$defs/ids"
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "home"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "properties": {
              "domain_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "path",
        "status",
        "date",
        "title",
        "summary",
        "tags",
        "scopes",
        "sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "authority": {
          "$ref": "#/$defs/authority"
        },
        "kind": {
          "enum": [
            "constitution",
            "decision",
            "spec",
            "lesson",
            "reference",
            "research"
          ]
        },
        "path": {
          "type": "string",
          "description": "CD-0194 D2: the record path rule lives in $defs.record.allOf as two implications. A path under the default tree must carry the default-tree shape; a path outside it is an external placement admitted only through an explicit operator override whose closed shape the then-clause declares. The override and its anchor decision are proven by the composer, the checkers, and the store parser, never by this pattern.",
          "maxLength": 512
        },
        "status": {
          "enum": [
            "accepted",
            "published"
          ]
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "tags": {
          "$ref": "#/$defs/ids"
        },
        "scopes": {
          "$ref": "#/$defs/scopeV12"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "law_relations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/lawRelation"
          }
        },
        "evidence": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/evidencePath"
          }
        },
        "criterion_bindings": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/criterionBinding"
          }
        },
        "home_domain_id": {
          "$ref": "#/$defs/id"
        },
        "applies_to_domain_ids": {
          "$ref": "#/$defs/ids"
        },
        "product_wide_rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.concord/docs/.*\\.md$"
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "description": "CD-0194 D2: inside the default tree the authored path rule applies: the tier's work, research, and generated content exclusions hold. The Go model cannot compile the lookahead (RE2), so knowledge_vocabulary_test.go decomposes this pattern; keep its text in the '^.concord/docs/(?!<alternation>).*\\.md$' shape.",
                "pattern": "^.concord/docs/(?!work/|research/|.*[Gg][Ee][Nn][Ee][Rr][Aa][Tt][Ee][Dd]).*\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "published"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "spec"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "accepted"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "decision"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "pattern": "^.concord/docs/decisions/CD-[0-9]{4}(-.*)?\\.md$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "law_relations": {}
            },
            "required": [
              "law_relations"
            ]
          },
          "then": {
            "properties": {
              "kind": {
                "enum": [
                  "decision",
                  "spec"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "criterion_bindings"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "path": {
                "type": "string",
                "not": {
                  "pattern": "^\\.concord/docs/.*\\.md$"
                }
              }
            },
            "required": [
              "path"
            ]
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "description": "CD-0194 D2: a record path outside the default tree is admitted only when the manifest head carries an explicit operator override that covers it. The pattern declares the closed external shape; the override itself, and the accepted decision that anchors it, are proven by the composer, the checkers, and the store parser. The generated-substring exclusion and the dot-segment refusals apply in every tree.",
                "pattern": "^(?!.*[Gg][Ee][Nn][Ee][Rr][Aa][Tt][Ee][Dd])(?!(?:.*/)?\\.\\.(?:/|$))(?!(?:.*/)?\\.(?:/|$))[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.md$",
                "maxLength": 512
              }
            }
          }
        }
      ]
    },
    "recordV12": {
      "allOf": [
        {
          "$ref": "#/$defs/record"
        },
        {
          "properties": {
            "scopes": {
              "$ref": "#/$defs/scopeV12"
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "constitution",
                  "decision",
                  "spec"
                ]
              },
              "status": {
                "const": "accepted"
              }
            },
            "required": [
              "kind",
              "status"
            ]
          },
          "then": {
            "required": [
              "home_domain_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "lesson",
                  "reference",
                  "research"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "home_domain_id"
                  ]
                },
                {
                  "required": [
                    "applies_to_domain_ids"
                  ]
                },
                {
                  "required": [
                    "product_wide_rationale"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "applies_to_domain_ids"
            ]
          },
          "then": {
            "required": [
              "home_domain_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "home_domain_id": {
                "pattern": "^product-root:"
              }
            },
            "required": [
              "home_domain_id"
            ]
          },
          "then": {
            "required": [
              "product_wide_rationale"
            ]
          },
          "else": {
            "not": {
              "required": [
                "product_wide_rationale"
              ]
            }
          }
        }
      ]
    },
    "domainRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_key",
        "root_domain_id",
        "domains"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "product_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "root_domain_id": {
          "type": "string",
          "pattern": "^product-root:[a-z][a-z0-9-]{1,63}$"
        },
        "domains": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/domain"
          }
        }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain_id",
        "name",
        "purpose",
        "status",
        "architecture_relations"
      ],
      "properties": {
        "domain_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "parent_domain_id": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": [
            "current",
            "deprecated"
          ]
        },
        "architecture_relations": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/architectureRelation"
          }
        }
      }
    },
    "architectureRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_domain_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "depends_on",
            "shares_contract_with",
            "replaces"
          ]
        },
        "target_domain_id": {
          "$ref": "#/$defs/id"
        },
        "governing_law_ids": {
          "$ref": "#/$defs/ids"
        },
        "state": {
          "enum": [
            "declared",
            "building",
            "coexisting",
            "cutover",
            "retired"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "depends_on",
                  "shares_contract_with"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "governing_law_ids"
            ],
            "properties": {
              "governing_law_ids": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "state"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "replaces"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "state"
            ],
            "not": {
              "required": [
                "governing_law_ids"
              ]
            }
          }
        }
      ]
    },
    "lawRelation": {
      "description": "A typed relation between law records in this manifest.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "target_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "refines",
            "subordinate_to",
            "conflicts_with"
          ]
        },
        "target_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "criterionBinding": {
      "description": "CD-0180: one acceptance criterion resolves through exactly one of three forms \u2014 a scenario id, a recorded exemption reason, or a work-item predicate reference (work_id plus predicate_id) that ties the criterion to the outcome predicate of one Concord work item.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion"
      ],
      "properties": {
        "criterion": {
          "type": "integer",
          "minimum": 1
        },
        "scenario": {
          "$ref": "#/$defs/id"
        },
        "exemption": {
          "type": "string",
          "minLength": 12,
          "maxLength": 512,
          "pattern": "^\\S(?:[\\s\\S]*\\S)?$"
        },
        "work_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^work-[0-9a-f]{8,64}$"
        },
        "predicate_id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^predicate:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "oneOf": [
        {
          "required": [
            "scenario"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "exemption"
                ]
              },
              {
                "required": [
                  "work_id"
                ]
              },
              {
                "required": [
                  "predicate_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "exemption"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scenario"
                ]
              },
              {
                "required": [
                  "work_id"
                ]
              },
              {
                "required": [
                  "predicate_id"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "work_id",
            "predicate_id"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scenario"
                ]
              },
              {
                "required": [
                  "exemption"
                ]
              }
            ]
          }
        }
      ]
    },
    "knowledgeRoots": {
      "type": "array",
      "default": [
        ".concord/docs/"
      ],
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*/$",
        "maxLength": 256
      }
    },
    "knowledgeExclusions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*(?:/|\\.md)$",
        "maxLength": 256
      }
    },
    "operatorOverrides": {
      "type": "array",
      "description": "CD-0194 D2: the only escape from default .concord/ placement. Each entry records one explicit operator override, tied to one Product; an inferred exception refuses.",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "product_id",
          "recorded_in",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "description": "The repository-relative location, outside .concord/, where Product knowledge is allowed to live.",
            "pattern": "^[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*(?:/|\\.md)$",
            "maxLength": 256
          },
          "product_id": {
            "type": "string",
            "description": "The Product the override belongs to.",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^\\S(?:.*\\S)?$"
          },
          "recorded_in": {
            "$ref": "#/$defs/id",
            "description": "CD-0194 D2: the id of the manifest record that carries the operator's instruction. It is the only anchor a repository check can verify; a work item lives in the external store and never anchors an override. The anchor must be an accepted decision whose document carries the closed concord-operator-override instruction block for the override's exact Product and path with the approve decision. The knowledge placement check resolves the id against the manifest's records and validates the anchor."
          },
          "reason": {
            "type": "string",
            "minLength": 12,
            "maxLength": 512
          }
        }
      }
    },
    "dispositions": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/disposition"
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "disposition",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?![\\s\\S]*\\.\\.)[a-zA-Z0-9._-]+(?:/[a-zA-Z0-9._-]+)*\\.md$"
        },
        "disposition": {
          "enum": [
            "archived"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.3"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "required": [
                "authority"
              ]
            }
          }
        }
      }
    }
  ]
}
