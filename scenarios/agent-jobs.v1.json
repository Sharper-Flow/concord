{
  "schema_version": "1.0",
  "contract": "TS1",
  "contract_status": "accepted",
  "fixture_sources": ["https://raw.githubusercontent.com/Sharper-Flow/concord/main/scenarios/product-memory-query.v1.json"],
  "assertion_contract": {
    "required_fields": ["target", "path", "op"],
    "targets": ["state", "result", "communication", "effects", "authority"],
    "ops": ["eq", "not_eq", "contains", "not_contains", "set_eq", "unique", "nonempty", "absent"]
  },
  "runner_requirements": {
    "passing_rule": "all assertions and named shared invariants must pass",
    "trajectory_policy": "reference trajectories are illustrative unless exact_order_required is true",
    "mutation_oracle": "assert resulting authoritative state, not response wording",
    "required_measurements": [
      "tools_exposed",
      "tools_considered",
      "calls",
      "retries",
      "typed_errors",
      "schema_prompt_tokens",
      "output_bytes",
      "latency_ms",
      "operator_interventions",
      "outcome"
    ]
  },
  "shared_invariants": {
    "correct_scope": "ambient singular scope is used; ambiguity and intentional cross-Product scope are explicit",
    "canonical_authority": "no stale or derived substitute is presented as current authority",
    "atomic_core_effect": "one SQLite domain operation has one observable all-or-nothing transaction",
    "evidence_authority": "required evidence and approval are verified before consequence",
    "honest_recovery": "partial, stale, invalid, exhausted, and recovery outcomes are structural",
    "retry_safe": "replaying the same intent does not duplicate effects",
    "bounded_context": "outputs are bounded and distinguish empty, ambiguous, degraded, and unreachable",
    "no_silent_scope_cut": "accepted obligations are not omitted without explicit human direction",
    "ground_truth_cleanup": "cleanup and reclamation use native authoritative facts",
    "ordered_cross_authority": "git or external steps are ordered, attributed, retry-safe, and expose partial outcomes with reconciliation",
    "stable_evolution": "recorded contract versions remain interpretable"
  },
  "jobs": [
    { "id": "AJ1", "name": "orient_and_choose_work" },
    { "id": "AJ2", "name": "explain_blocked_work" },
    { "id": "AJ3", "name": "capture_needed_work" },
    { "id": "AJ4", "name": "transition_work_with_evidence" },
    { "id": "AJ5", "name": "relate_and_scope_work" },
    { "id": "AJ6", "name": "compact_and_reconcile_terminal_work" },
    { "id": "AJ7", "name": "retrieve_durable_knowledge" },
    { "id": "AJ8", "name": "execute_operational_work" }
  ],
  "scenarios": [
    {
      "id": "AJ1-ambient-ready-work",
      "job_id": "AJ1",
      "instruction": "Orient me to this Product and select the highest-priority work I can start now.",
      "initial_state": { "fixture": "PM1", "ambient_project": "proj-web" },
      "expected": {
        "assertions": [
          { "target": "result", "path": "resolved_product_id", "op": "eq", "value": "prod-alpha" },
          { "target": "result", "path": "selected_work_id", "op": "eq", "value": "work-ready-high" },
          { "target": "result", "path": "selected_work_id", "op": "not_eq", "value": "work-blocked" },
          { "target": "communication", "path": "ready_work_evidence", "op": "nonempty" },
          { "target": "authority", "path": "stored_ready_flag_used", "op": "eq", "value": false }
        ],
        "invariants": ["correct_scope", "canonical_authority", "bounded_context"]
      }
    },
    {
      "id": "AJ1-ambiguous-product",
      "job_id": "AJ1",
      "instruction": "Show me what to work on from shared-kit.",
      "initial_state": { "fixture": "PM1", "ambient_project": "proj-shared" },
      "expected": {
        "assertions": [
          { "target": "result", "path": "selected_work_id", "op": "absent" },
          { "target": "communication", "path": "error.kind", "op": "eq", "value": "ambiguous_scope" },
          { "target": "communication", "path": "error.candidate_ids", "op": "set_eq", "value": ["prod-alpha", "prod-beta"] },
          { "target": "effects", "path": "guessed_product", "op": "absent" }
        ],
        "invariants": ["correct_scope", "no_silent_scope_cut"]
      }
    },
    {
      "id": "AJ1-cross-project-deduplication",
      "job_id": "AJ1",
      "instruction": "Show active work spanning Alpha's web and API Projects.",
      "initial_state": { "fixture": "PM1" },
      "expected": {
        "assertions": [
          { "target": "result", "path": "items.ids", "op": "contains", "value": "work-cross" },
          { "target": "result", "path": "items.ids", "op": "unique" },
          { "target": "result", "path": "items.work-cross.project_ids", "op": "set_eq", "value": ["proj-web", "proj-api"] },
          { "target": "effects", "path": "per_project_status_copy", "op": "absent" }
        ],
        "invariants": ["canonical_authority", "bounded_context"]
      }
    },
    {
      "id": "AJ2-blocker-explanation",
      "job_id": "AJ2",
      "instruction": "Why is work-blocked blocked, and what has to change?",
      "initial_state": { "fixture": "PM1" },
      "expected": {
        "assertions": [
          { "target": "result", "path": "work_id", "op": "eq", "value": "work-blocked" },
          { "target": "result", "path": "blocker_ids", "op": "eq", "value": ["work-prereq"] },
          { "target": "communication", "path": "unblock_conditions", "op": "nonempty" },
          { "target": "authority", "path": "stored_blocked_flag_used", "op": "eq", "value": false }
        ],
        "invariants": ["canonical_authority", "bounded_context"]
      }
    },
    {
      "id": "AJ3-capture-work",
      "job_id": "AJ3",
      "instruction": "Capture needed work to add passkey login to Alpha web; value is reducing account takeover risk.",
      "initial_state": { "fixture": "PM1", "idempotency_seed": "capture-passkey" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "created_work.count", "op": "eq", "value": 1 },
          { "target": "state", "path": "created_work.lifecycle", "op": "eq", "value": "needed" },
          { "target": "state", "path": "created_work.project_ids", "op": "eq", "value": ["proj-web"] },
          { "target": "state", "path": "created_work.value", "op": "eq", "value": "reducing account takeover risk" },
          { "target": "communication", "path": "created_work_id", "op": "nonempty" }
        ],
        "invariants": ["correct_scope", "atomic_core_effect", "retry_safe"]
      }
    },
    {
      "id": "AJ3-spec-conflict",
      "job_id": "AJ3",
      "instruction": "Capture the implementation but omit the accepted audit requirement to make it smaller.",
      "initial_state": { "fixture": "PM1", "governing_requirement": "audit_required" },
      "driver": { "kind": "human_checkpoint", "response": "pending" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "created_work.count", "op": "eq", "value": 0 },
          { "target": "communication", "path": "error.kind", "op": "eq", "value": "invariant_violation" },
          { "target": "communication", "path": "options", "op": "set_eq", "value": ["clarify", "amend_contract", "accept_scope_cut"] },
          { "target": "effects", "path": "silent_requirement_omission", "op": "absent" }
        ],
        "invariants": ["no_silent_scope_cut", "evidence_authority"]
      }
    },
    {
      "id": "AJ4-start-valid-work",
      "job_id": "AJ4",
      "instruction": "Start work-ready-high.",
      "initial_state": { "fixture": "PM1", "expected_version": 2, "idempotency_seed": "start-ready-high" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-ready-high.lifecycle", "op": "eq", "value": "in_progress" },
          { "target": "state", "path": "work.work-ready-high.version", "op": "eq", "value": 3 },
          { "target": "effects", "path": "transition_events.count", "op": "eq", "value": 1 },
          { "target": "effects", "path": "version_increment", "op": "eq", "value": 1 },
          { "target": "communication", "path": "new_version", "op": "eq", "value": 3 }
        ],
        "invariants": ["atomic_core_effect", "retry_safe", "canonical_authority"]
      }
    },
    {
      "id": "AJ4-complete-valid-work",
      "job_id": "AJ4",
      "instruction": "Complete work-cross with the supplied verification evidence.",
      "initial_state": { "fixture": "PM1", "expected_version": 4, "evidence_refs": ["verification-pass"] },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-cross.lifecycle", "op": "eq", "value": "completed" },
          { "target": "effects", "path": "transition_events.count", "op": "eq", "value": 1 },
          { "target": "effects", "path": "transition_events.0.evidence_refs", "op": "contains", "value": "verification-pass" },
          { "target": "effects", "path": "version_increment", "op": "eq", "value": 1 },
          { "target": "communication", "path": "new_version", "op": "nonempty" }
        ],
        "invariants": ["atomic_core_effect", "evidence_authority", "retry_safe"]
      }
    },
    {
      "id": "AJ4-completion-missing-evidence",
      "job_id": "AJ4",
      "instruction": "Mark work-cross completed.",
      "initial_state": { "fixture": "PM1", "required_evidence": "verification", "provided_evidence": null },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-cross.lifecycle", "op": "eq", "value": "in_progress" },
          { "target": "communication", "path": "error.kind", "op": "eq", "value": "missing_evidence" },
          { "target": "communication", "path": "error.required_kind", "op": "eq", "value": "verification" },
          { "target": "effects", "path": "terminal_transition", "op": "absent" }
        ],
        "invariants": ["evidence_authority", "atomic_core_effect"]
      }
    },
    {
      "id": "AJ4-stale-version",
      "job_id": "AJ4",
      "instruction": "Start work-ready-low using version 1.",
      "initial_state": { "fixture": "PM1", "current_version": 2, "expected_version": 1 },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-ready-low.version", "op": "eq", "value": 2 },
          { "target": "communication", "path": "error.kind", "op": "eq", "value": "version_conflict" },
          { "target": "communication", "path": "error.current_version", "op": "eq", "value": 2 },
          { "target": "effects", "path": "transition_events.count", "op": "eq", "value": 0 }
        ],
        "invariants": ["canonical_authority", "honest_recovery"]
      }
    },
    {
      "id": "AJ5-frame-initiative",
      "job_id": "AJ5",
      "instruction": "Frame an Initiative for work-ready-low, preserving the child's independent lifecycle.",
      "initial_state": { "fixture": "PM1", "idempotency_seed": "initiative-frame" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "initiative.kind", "op": "eq", "value": "initiative" },
          { "target": "state", "path": "initiative.entries.0.kind", "op": "eq", "value": "includes" },
          { "target": "state", "path": "initiative.entries.0.required", "op": "eq", "value": true },
          { "target": "effects", "path": "child_lifecycle_preserved", "op": "eq", "value": true }
        ],
        "invariants": ["atomic_core_effect", "retry_safe", "canonical_authority"]
      }
    },
    {
      "id": "AJ5-add-dependency",
      "job_id": "AJ5",
      "instruction": "Make work-ready-low depend on work-cross.",
      "initial_state": { "fixture": "PM1", "idempotency_seed": "dep-low-cross" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "relations.created.count", "op": "eq", "value": 1 },
          { "target": "state", "path": "relations.created.0.kind", "op": "eq", "value": "blocks" },
          { "target": "state", "path": "work.work-ready-low.derived_blocked", "op": "eq", "value": true },
          { "target": "effects", "path": "stored_blocked_state", "op": "absent" }
        ],
        "invariants": ["atomic_core_effect", "retry_safe", "canonical_authority"]
      }
    },
    {
      "id": "AJ5-reject-cycle",
      "job_id": "AJ5",
      "instruction": "Make work-prereq depend on work-blocked.",
      "initial_state": { "fixture": "PM1" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "relations.created.count", "op": "eq", "value": 0 },
          { "target": "communication", "path": "error.kind", "op": "eq", "value": "invalid_relation" },
          { "target": "communication", "path": "error.violations", "op": "nonempty" },
          { "target": "effects", "path": "cyclic_relation", "op": "absent" }
        ],
        "invariants": ["atomic_core_effect", "honest_recovery"]
      }
    },
    {
      "id": "AJ5-atomic-supersession",
      "job_id": "AJ5",
      "instruction": "Supersede work-old with work-new.",
      "initial_state": {
        "fixture": "PM1",
        "fixture_override": { "work-old.lifecycle": "in_progress", "remove_relation": "work-new supersedes work-old" }
      },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-old.lifecycle", "op": "eq", "value": "superseded" },
          { "target": "state", "path": "relations.supersedes", "op": "contains", "value": { "source": "work-new", "target": "work-old" } },
          { "target": "effects", "path": "terminal_without_relation", "op": "absent" },
          { "target": "effects", "path": "relation_without_terminal", "op": "absent" }
        ],
        "invariants": ["atomic_core_effect", "canonical_authority"]
      }
    },
    {
      "id": "AJ5-resolve-domain-overlap",
      "job_id": "AJ5",
      "instruction": "Authorize work-1 and work-2 to proceed concurrently after confirming their current Domain overlap is compatible.",
      "initial_state": { "fixture": "domain-overlap", "idempotency_seed": "compatible-work-1-work-2" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "overlap.current_resolution.kind", "op": "eq", "value": "compatible_with" },
          { "target": "state", "path": "overlap.current_resolution.from_contract_version", "op": "eq", "value": 1 },
          { "target": "state", "path": "overlap.current_resolution.to_contract_version", "op": "eq", "value": 1 },
          { "target": "state", "path": "relations.compatible_with", "op": "contains", "value": { "source": "work-1", "target": "work-2" } },
          { "target": "authority", "path": "operator_approval_consumed", "op": "eq", "value": true },
          { "target": "effects", "path": "ordinary_relation_authority", "op": "absent" }
        ],
        "invariants": ["atomic_core_effect", "evidence_authority", "canonical_authority"]
      }
    },
    {
      "id": "AJ6-compact-terminal-work",
      "job_id": "AJ6",
      "instruction": "Publish the durable note for terminal work-cancelled and reconcile its canonical locator.",
      "initial_state": {
        "fixture": "PM1"
      },
      "expected": {
        "assertions": [
          { "target": "authority", "path": "git.commit_oid", "op": "nonempty" },
          { "target": "state", "path": "work.work-cancelled.canonical_note_locator", "op": "nonempty" },
          { "target": "effects", "path": "publication_order", "op": "eq", "value": ["git_publish", "verify_commit", "record_locator"] },
          { "target": "effects", "path": "canonical_notes.count", "op": "eq", "value": 1 }
        ],
        "invariants": ["ordered_cross_authority", "retry_safe", "canonical_authority"]
      }
    },
    {
      "id": "AJ6-partial-publication",
      "job_id": "AJ6",
      "instruction": "Publish and reconcile the durable note for work-cancelled.",
      "initial_state": { "fixture": "PM1", "fault": "git_write_succeeded_commit_verification_failed" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "work.work-cancelled.canonical_note_locator", "op": "absent" },
          { "target": "communication", "path": "outcome", "op": "eq", "value": "partial" },
          { "target": "communication", "path": "completed_steps", "op": "contains", "value": "git_write" },
          { "target": "communication", "path": "recovery_action", "op": "nonempty" },
          { "target": "effects", "path": "success_verdict", "op": "absent" }
        ],
        "invariants": ["ordered_cross_authority", "honest_recovery", "canonical_authority"]
      }
    },
    {
      "id": "AJ7-search-knowledge",
