    {
      "id": "AJ8-health-failure-rollback",
      "job_id": "AJ8",
      "instruction": "Apply the approved production routing change, verify health, and roll back on failure.",
      "initial_state": { "approval": "valid", "native_authority": "routing-provider", "health_after_apply": "failed", "rollback": "declared" },
      "expected": {
        "assertions": [
          { "target": "state", "path": "native_change.status", "op": "eq", "value": "rolled_back" },
          { "target": "communication", "path": "outcome", "op": "eq", "value": "partial" },
          { "target": "communication", "path": "health_failure", "op": "nonempty" },
          { "target": "communication", "path": "rollback_result", "op": "nonempty" },
