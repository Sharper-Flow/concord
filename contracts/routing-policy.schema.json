{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/routing-policy.schema.json",
  "title": "Concord worker routing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry", "version", "policies"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "registry": {"const": "routing_policy"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_.-]{0,63}$"},
    "policies": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/policy"}}
  },
  "$defs": {
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_class", "preferred_model", "resolution_set"],
      "properties": {
        "capability_class": {"type": "string", "minLength": 2, "maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
        "preferred_model": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*/[^/ ]+$"},
        "resolution_set": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_.-]*/[^/ ]+$"}}
      }
    }
  }
}
