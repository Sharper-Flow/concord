{
  "schema_version": "1.0",
  "tools": [
    {
      "name": "concord_work_start",
      "description": "Capture work from a default checkout, or resume by work_id or recorded issue_key. Reuse an active worktree or bootstrap its missing canonical entry. A successful claim moves the session and verifies the landing; vacate returns it to the registered main; never claim from a default checkout. Resume takes exactly one selector in the calling session's Project; another Project here uses worktree_claim; another repository needs a host-started session.",
      "args": {
        "oneOf": [
          {
            "additionalProperties": false,
            "properties": {
              "defect_intake": {
                "additionalProperties": false,
                "description": "Capture admission record for defects: required for kind bug, optional for kind research, refused for every other kind (the core enforces the kind rules and the admission decision). failure_shape is a canonical bounded slug identifier repeated on every capture of the defect class; reproduction and searched are bounded nonempty text; related_defect_ids declares distinct earlier work IDs of the same shape and may be empty; root_cause_work_id names the completed workflow.research cluster RCA a recurrent bug capture needs.",
                "properties": {
                  "failure_shape": {
                    "maxLength": 64,
                    "minLength": 1,
                    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                    "type": "string",
                    "description": "Bounds: 1..64 code points inclusive"
                  },
                  "related_defect_ids": {
                    "items": {
                      "maxLength": 128,
                      "minLength": 1,
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                      "type": "string",
                      "description": "Bounds: 1..128 code points inclusive"
                    },
                    "maxItems": 20,
                    "type": "array",
                    "uniqueItems": true,
                    "description": "Bounds: <=20 items inclusive"
                  },
                  "reproduction": {
                    "maxLength": 8192,
                    "minLength": 1,
                    "type": "string",
                    "x-maxBytes": 8192,
                    "description": "Bounds: 1..8192 code points inclusive; <=8192 UTF-8 bytes inclusive"
                  },
                  "root_cause_work_id": {
                    "maxLength": 128,
                    "minLength": 1,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                    "type": "string",
                    "description": "Bounds: 1..128 code points inclusive"
                  },
                  "searched": {
                    "maxLength": 8192,
                    "minLength": 1,
                    "type": "string",
                    "x-maxBytes": 8192,
                    "description": "Bounds: 1..8192 code points inclusive; <=8192 UTF-8 bytes inclusive"
                  }
                },
                "required": [
                  "failure_shape",
                  "reproduction",
                  "searched",
                  "related_defect_ids"
                ],
                "type": "object"
              },
              "external_ref": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
                "x-maxBytes": 256,
                "description": "Bounds: 1..256 code points inclusive; <=256 UTF-8 bytes inclusive"
              },
              "governing_requirements": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string",
                  "description": "Bounds: 1..128 code points inclusive"
                },
                "maxItems": 32,
                "type": "array",
                "uniqueItems": true,
                "description": "Bounds: <=32 items inclusive"
              },
              "idempotency_key": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string",
                "description": "Bounds: 1..128 code points inclusive"
              },
              "kind": {
                "enum": [
                  "task",
                  "bug",
                  "decision",
                  "research",
                  "other"
                ],
                "type": "string"
              },
              "priority": {
                "maximum": 100,
                "minimum": -100,
                "type": "integer",
                "description": "Bounds: -100..100 value inclusive"
              },
              "raised_from_work_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string",
                "description": "Bounds: 1..128 code points inclusive"
              },
              "ref": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string",
                "description": "Bounds: 1..128 code points inclusive"
              },
              "size_inputs": {
                "additionalProperties": false,
                "description": "What this change will touch, for the work-item size model (CD-0229 D4). Name the files, a behavior phrase, or both. The tool derives kind, stage, audience, Domains, packages, and repositories; the model decides the size. There is no size field: a proposed size is refused.",
                "properties": {
                  "behavior": {
                    "description": "A phrase for the behavior the change will alter, when the files are not known yet. Bounds: 1..256 code points inclusive",
                    "maxLength": 256,
                    "minLength": 1,
                    "type": "string"
                  },
                  "blast_radius": {
                    "description": "The widest thing a defect could break: one function, one package, several packages, or a public surface (CLI, tool, schema, wire format).",
                    "enum": [
                      "contained",
                      "package",
                      "cross_package",
                      "external"
                    ],
                    "type": "string"
                  },
                  "estimated_production_lines": {
                    "description": "Production lines you expect to add or change, tests excluded. Bounds: 1..100000 value inclusive",
                    "maximum": 100000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "paths": {
                    "description": "Repository-relative files or directories the change will edit. Bounds: <=64 items inclusive",
                    "items": {
                      "maxLength": 512,
                      "minLength": 1,
                      "type": "string",
                      "description": "Bounds: 1..512 code points inclusive"
                    },
                    "maxItems": 64,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "security": {
                    "description": "True when the change touches authentication, authorization, secrets, or data safety.",
                    "type": "boolean"
                  },
                  "user_visible": {
                    "description": "True when the change removes or reverses behavior users see, or changes UI or UX.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "security",
                  "user_visible",
                  "blast_radius",
                  "estimated_production_lines"
                ],
                "type": "object"
              },
              "tags": {
                "items": {
                  "maxLength": 128,
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                  "type": "string",
                  "description": "Bounds: 1..128 code points inclusive"
                },
                "maxItems": 32,
                "type": "array",
                "uniqueItems": true,
                "description": "Bounds: <=32 items inclusive"
              },
              "task": {
                "maxLength": 8192,
                "minLength": 1,
                "type": "string",
                "x-maxBytes": 8192,
                "description": "Bounds: 1..8192 code points inclusive; <=8192 UTF-8 bytes inclusive"
              },
              "title": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
                "x-maxBytes": 256,
                "description": "Bounds: 1..256 code points inclusive; <=256 UTF-8 bytes inclusive"
              },
              "urgency": {
                "enum": [
                  "standard",
                  "expedite"
                ],
                "type": "string"
              },
              "value_statement": {
                "maxLength": 256,
                "minLength": 1,
                "type": "string",
                "x-maxBytes": 256,
                "description": "Bounds: 1..256 code points inclusive; <=256 UTF-8 bytes inclusive"
              },
              "workflow_type_ref": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string",
                "description": "Bounds: 1..128 code points inclusive"
              }
            },
            "required": [
              "title",
              "value_statement",
              "kind",
              "task",
              "idempotency_key"
            ]
          },
          {
            "additionalProperties": false,
            "properties": {
              "issue_key": {
                "maxLength": 64,
                "minLength": 3,
                "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
                "type": "string",
                "description": "Exact locally recorded Linear issue key. The CLI resolves it to one work item; ambiguity or foreign scope refuses. Bounds: 3..64 code points inclusive"
              },
              "work_id": {
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
                "type": "string",
                "description": "Bounds: 1..128 code points inclusive"
              }
            },
            "oneOf": [
              {
                "required": [
                  "work_id"
                ]
              },
              {
                "required": [
                  "issue_key"
                ]
              }
            ]
          }
        ],
        "type": "object"
      }
    },
    {
      "name": "concord_ci_watch",
      "description": "Start watching GitHub CI and return at once: the concord ci-wait verb runs as a plugin-owned child with zero model turns, and this session receives the terminal JSON report as a message when the wait ends. Pass repo (owner/name), one selector (kind pr, sha, or run with its value), and optionally mode (checks or merge) and time_seconds_max. After a push to the pull request, also pass head_sha, the pushed commit: the wait then judges that commit, never the head it replaces.",
      "args": {
        "type": "object",
        "properties": {
          "repo": {
            "type": "string",
            "description": "GitHub repository as owner/name. Bounds: 3..256 code points inclusive",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*/[A-Za-z0-9][A-Za-z0-9.-]*$",
            "minLength": 3,
            "maxLength": 256
          },
          "selector": {
            "type": "object",
            "description": "One CI selector: kind pr, sha, or run, with its value.",
            "additionalProperties": false,
            "required": [
              "kind",
              "value"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "pr",
                  "sha",
                  "run"
                ]
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "description": "Bounds: 1..64 code points inclusive"
              }
            }
          },
          "head_sha": {
            "type": "string",
            "description": "For a pr selector: the commit to judge, usually the one just pushed. The wait stays pending until the pull request head reaches it.",
            "pattern": "^[0-9a-f]{40}$"
          },
          "mode": {
            "type": "string",
            "description": "Wait mode: checks (default) or merge.",
            "enum": [
              "checks",
              "merge"
            ]
          },
          "time_seconds_max": {
            "type": "integer",
            "description": "Maximum wait budget in seconds. Checks mode defaults to and caps at 1800; merge mode defaults to and caps at 7200. A shorter explicit budget is preserved across slices. Bounds: 0..7200 value inclusive",
            "minimum": 0,
            "maximum": 7200
          }
        },
        "required": [
          "repo",
          "selector"
        ],
        "additionalProperties": false
      }
    }
  ]
}
