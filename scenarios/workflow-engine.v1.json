{
  "$schema": "contracts/workflow-engine-scenarios.schema.json",
  "schema_version": "1.0",
  "contract": "CD-0013",
  "contract_status": "accepted",
  "surface_version": "1.0.0",
  "engine_status": "specification_only",
  "pending_amendments": [{"error_kind": "outcome_mismatch", "surface_version": "2.0.0", "ships_with": "workflow_engine", "status": "pending"}],
  "fixtures": {
    "work_items": [
      {"id": "work-alpha", "kind": "implementation", "state": "planned", "definition_ref": "workflow.implementation", "definition_version": 1},
      {"id": "work-beta", "kind": "research", "state": "running", "definition_ref": "workflow.research", "definition_version": 1},
      {"id": "work-spike", "kind": "architecture_spike", "state": "verifying", "definition_ref": "workflow.architecture_spike", "definition_version": 1},
      {"id": "work-ops", "kind": "ops_runbook", "state": "awaiting_condition", "definition_ref": "workflow.ops_runbook", "definition_version": 1},
      {"id": "work-child", "kind": "break_fix", "state": "ready", "definition_ref": "workflow.break_fix", "definition_version": 1}
    ],
    "actors": [
      {"actor_ref": "actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad", "principal_ref": "principal:operator", "client_ref": "client:concord-1", "actor_class": "agent", "agent_ref": "agent-engineer", "session_ref": "session-executor"},
      {"actor_ref": "actor:017389e1649c56f00f9265c121eed78cb73aca12052cefae3df35d9036a029bc", "principal_ref": "principal:operator", "client_ref": "client:concord-1", "actor_class": "operator", "agent_ref": "agent-reviewer", "session_ref": "session-reviewer"}
    ],
    "definitions": [
      {"ref": "workflow.implementation", "version": 1, "digest": "sha256:2c4ec2956bc3e734b60bb145fdae835dc0032065cf293d3407ac9930c045e300"},
      {"ref": "workflow.research", "version": 1, "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
      {"ref": "workflow.architecture_spike", "version": 1, "digest": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"},
      {"ref": "workflow.ops_runbook", "version": 1, "digest": "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"},
      {"ref": "workflow.break_fix", "version": 1, "digest": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"}
    ],
    "evidence": [
      {"kind": "verification", "subject": "commit:1111111111111111111111111111111111111111111111111111111111111111", "producer": "runner", "run": "run-verify-1"},
      {"kind": "review", "subject": "commit:2222222222222222222222222222222222222222222222222222222222222222", "producer": "reviewer", "run": "review-1"}
    ],
    "relations": [
      {"source": "work-alpha", "target": "work-child", "kind": "depends_on", "class": "hard", "severity": "breaking"}
    ]
  },
  "assertion_contract": {
    "required_fields": ["target", "path", "op"],
    "targets": ["state", "result", "communication", "effects", "authority"],
    "ops": ["eq", "not_eq", "contains", "not_contains", "set_eq", "unique", "nonempty", "absent"]
  },
  "runner_requirements": {
    "passing_rule": "all assertions and named invariants pass",
    "mutation_oracle": "assert authoritative event and projection state, never response wording",
    "stub_resistance": "each scenario must assert at least two independent authoritative targets, including state, effects, or authority; a canned response without the durable transition fails",
    "required_measurements": ["events_appended", "projection_rows", "typed_errors", "idempotency_effects", "authority", "outcome"],
    "evaluation_order": "validate fixture, action payload, and typed refusal before expected authoritative-state assertions"
  },
  "scenarios": [
    {"id": "WF01-capture-late-outcome", "scenario_number": 1, "mechanism": "capture permits missing end-state; planning supplies it", "initial_state": {"work": "new", "outcome": null}, "action": "capture", "expected": {"assertions": [{"target": "state", "path": "work.lifecycle", "op": "eq", "value": "needed"}, {"target": "state", "path": "work.outcome_contract", "op": "absent"}, {"target": "communication", "path": "error", "op": "absent"}, {"target": "effects", "path": "work.created_event", "op": "nonempty"}]}},
    {"id": "WF02-planning-requires-outcome", "scenario_number": 2, "mechanism": "planning refuses an omitted required end-state", "initial_state": {"work": "work-alpha", "outcome": null}, "action": "approve_contract", "expected": {"assertions": [{"target": "state", "path": "work-alpha.state", "op": "eq", "value": "planned"}, {"target": "communication", "path": "error.kind", "op": "eq", "value": "invariant_violation"}, {"target": "effects", "path": "contract_approved", "op": "absent"}]}},
    {"id": "WF03-vacuous-end-state", "scenario_number": 3, "mechanism": "planning refuses a predicate already true", "initial_state": {"work": "work-alpha", "outcome": {"kind": "exists", "subjects": ["artifact-existing"]}, "ground_truth": "artifact-existing-present"}, "action": "approve_contract", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "invariant_violation"}, {"target": "effects", "path": "contract_approved", "op": "absent"}]}},
    {"id": "WF04-weaker-delivery", "scenario_number": 4, "mechanism": "weaker outcome is refused", "initial_state": {"work": "work-alpha", "approved": "exists:capability-a-and-b", "delivered": "exists:capability-a"}, "action": "complete", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "outcome_mismatch"}, {"target": "state", "path": "work-alpha.state", "op": "not_eq", "value": "completed"}, {"target": "effects", "path": "workflow.completed", "op": "absent"}]}},
    {"id": "WF05-stronger-delivery", "scenario_number": 5, "mechanism": "stronger outcome is accepted", "initial_state": {"work": "work-alpha", "approved": "exists:capability-a", "delivered": "exists:capability-a-and-b"}, "action": "complete", "expected": {"assertions": [{"target": "state", "path": "work-alpha.state", "op": "eq", "value": "completed"}, {"target": "communication", "path": "outcome", "op": "eq", "value": "ok"}, {"target": "effects", "path": "workflow.completed", "op": "nonempty"}]}},
    {"id": "WF06-absence-removal", "scenario_number": 6, "mechanism": "absence passes only for true removal", "initial_state": {"work": "work-alpha", "approved": "absent:legacy-endpoint", "delivered": "absent:legacy-endpoint", "ground_truth": "removed"}, "action": "complete", "expected": {"assertions": [{"target": "state", "path": "work-alpha.state", "op": "eq", "value": "completed"}, {"target": "communication", "path": "outcome", "op": "eq", "value": "ok"}, {"target": "effects", "path": "workflow.completed", "op": "nonempty"}]}},
    {"id": "WF07-candidate-revision", "scenario_number": 7, "mechanism": "candidate revision appends without changing premise or predicate", "initial_state": {"work": "work-beta", "candidate_ids": ["case-a"], "premise_hash": "premise-1", "outcome_hash": "outcome-1"}, "action": "revise_candidates", "expected": {"assertions": [{"target": "state", "path": "candidates.ids", "op": "set_eq", "value": ["case-a", "case-b"]}, {"target": "state", "path": "contract.premise_hash", "op": "eq", "value": "premise-1"}, {"target": "state", "path": "contract.outcome_hash", "op": "eq", "value": "outcome-1"}, {"target": "effects", "path": "workflow.candidate_set_revised", "op": "nonempty"}]}},
    {"id": "WF08-premise-supersession", "scenario_number": 8, "mechanism": "premise revision supersedes rather than edits", "initial_state": {"work": "work-beta", "contract_version": 1, "premise": "old premise"}, "action": "supersede_contract", "expected": {"assertions": [{"target": "state", "path": "contracts.versions", "op": "set_eq", "value": [1, 2]}, {"target": "state", "path": "contracts.1.premise", "op": "eq", "value": "old premise"}, {"target": "effects", "path": "workflow.contract_superseded", "op": "nonempty"}]}},
    {"id": "WF09-execution-write-outcome", "scenario_number": 9, "mechanism": "execution cannot write approved outcome", "initial_state": {"work": "work-alpha", "state": "running", "approved_outcome": "check:approved"}, "action": "replace_outcome", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "unauthorized"}, {"target": "state", "path": "contract.outcome", "op": "eq", "value": "check:approved"}, {"target": "effects", "path": "workflow.contract_approved", "op": "absent"}]}},
    {"id": "WF10-forward-link-discovery", "scenario_number": 10, "mechanism": "discovered work forwards and does not close current work", "initial_state": {"work": "work-beta", "state": "running", "discovery": "new-defect"}, "action": "link_successor", "expected": {"assertions": [{"target": "state", "path": "work-beta.state", "op": "not_eq", "value": "completed"}, {"target": "state", "path": "successor.relation", "op": "eq", "value": "forward_link"}, {"target": "effects", "path": "successor_authority_independent", "op": "eq", "value": true}]}},
    {"id": "WF11-end-state-supersession-audit", "scenario_number": 11, "mechanism": "outcome supersession re-enters planning with audit shape", "initial_state": {"work": "work-alpha", "state": "running", "approved_contract": 1}, "action": "supersede_contract", "expected": {"assertions": [{"target": "state", "path": "work-alpha.state", "op": "eq", "value": "planned"}, {"target": "state", "path": "audit.supersedes", "op": "eq", "value": 1}, {"target": "communication", "path": "planning_required", "op": "eq", "value": true}, {"target": "effects", "path": "workflow.contract_superseded", "op": "nonempty"}]}},
    {"id": "WF12-self-authored-check", "scenario_number": 12, "mechanism": "executor cannot author or disable own check", "initial_state": {"work": "work-alpha", "executor": "actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad", "requested_check_author": "actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad"}, "action": "replace_check", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "unauthorized"}, {"target": "effects", "path": "check_replaced", "op": "absent"}]}},
    {"id": "WF13-verdict-actor-distinctness", "scenario_number": 13, "mechanism": "verdict actor must be complete and distinct", "initial_state": {"work": "work-alpha", "executor": "actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad"}, "action": "record_verdict", "cases": [
      {"id": "WF13-same-actor", "initial_state": {"verdict_actor": "actor:0bbb3c563caceaaffff6ea5979fdf44209be4a177b6b66fff4b9c6c0e72396ad", "verdict_tuple": "principal:operator|client:concord-1|agent-engineer|session-executor"}, "action": "record_verdict", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "unauthorized"}, {"target": "effects", "path": "workflow.verdict_recorded", "op": "absent"}]}},
      {"id": "WF13-partial-tuple", "initial_state": {"verdict_actor": "actor:partial", "verdict_tuple": "principal:operator|client:concord-1|agent-reviewer|"}, "action": "record_verdict", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "unauthorized"}, {"target": "effects", "path": "workflow.verdict_recorded", "op": "absent"}]}},
      {"id": "WF13-empty-tuple", "initial_state": {"verdict_actor": "", "verdict_tuple": "|||"}, "action": "record_verdict", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "unauthorized"}, {"target": "effects", "path": "workflow.verdict_recorded", "op": "absent"}]}}
    ]},
    {"id": "WF14-undeclared-route-convention", "scenario_number": 14, "mechanism": "operative route convention must be declared at approval", "initial_state": {"work": "work-alpha", "route_convention": "undeclared-archive"}, "action": "approve_contract", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "invariant_violation"}, {"target": "effects", "path": "contract_approved", "op": "absent"}]}},
    {"id": "WF15-lowest-rigor-floor", "scenario_number": 15, "mechanism": "lowest rigor band still requires outcome contract", "initial_state": {"work": "work-alpha", "maturity": "prototype", "audience": "internal", "outcome": "check:minimum"}, "action": "approve_contract", "expected": {"assertions": [{"target": "state", "path": "contract.required", "op": "eq", "value": true}, {"target": "state", "path": "rigor.proof_depth", "op": "nonempty"}, {"target": "effects", "path": "outcome_contract_omitted", "op": "absent"}]}},
    {"id": "WF16-research-no-change", "scenario_number": 16, "mechanism": "research no_change is satisfying", "initial_state": {"work": "work-beta", "kind": "research", "approved": ["no_change"], "verdict": "no_change"}, "action": "complete", "expected": {"assertions": [{"target": "state", "path": "work-beta.state", "op": "eq", "value": "completed"}, {"target": "communication", "path": "verdict.kind", "op": "eq", "value": "ok"}, {"target": "effects", "path": "workflow.completed", "op": "nonempty"}]}},
    {"id": "WF17-spike-insufficient-evidence", "scenario_number": 17, "mechanism": "spike insufficient_evidence requires accepted decision record", "initial_state": {"work": "work-spike", "kind": "architecture_spike", "verdict": "insufficient_evidence", "decision_record": "accepted"}, "action": "complete", "expected": {"assertions": [{"target": "state", "path": "work-spike.state", "op": "eq", "value": "completed"}, {"target": "authority", "path": "decision_record.operator_accepted", "op": "eq", "value": true}]}},
    {"id": "WF18-premise-unconfirmed", "scenario_number": 18, "mechanism": "passing postconditions do not bypass premise confirmation", "initial_state": {"work": "work-alpha", "predicate": "pass", "premise_confirmed": false}, "action": "complete", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "approval_required"}, {"target": "state", "path": "work-alpha.state", "op": "not_eq", "value": "completed"}, {"target": "effects", "path": "workflow.completed", "op": "absent"}]}},
    {"id": "WF19-completion-one-transaction", "scenario_number": 19, "mechanism": "contract verdict evidence and terminal metadata commit atomically", "initial_state": {"work": "work-alpha", "fault": "commit_after_verdict_fails"}, "action": "complete", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "operation_conflict"}, {"target": "state", "path": "workflow_instances.work-alpha.state", "op": "not_eq", "value": "completed"}, {"target": "effects", "path": "partial_terminal_metadata", "op": "absent"}]}},
    {"id": "WF20-internal-inline", "scenario_number": 20, "mechanism": "SQLite-only action is one inline domain operation", "initial_state": {"work": "work-alpha", "step_kind": "internal_sqlite"}, "action": "approve_contract", "expected": {"assertions": [{"target": "effects", "path": "domain_transaction.count", "op": "eq", "value": 1}, {"target": "effects", "path": "workflow.action_started", "op": "absent"}, {"target": "authority", "path": "durable_operation.fence", "op": "absent"}]}},
    {"id": "WF21-attempt-epoch-winner", "scenario_number": 21, "mechanism": "only current external attempt epoch completes", "initial_state": {"work": "work-ops", "epochs": [4, 5], "current_epoch": 5}, "action": "complete_external_step", "expected": {"assertions": [{"target": "state", "path": "epoch-5.status", "op": "eq", "value": "completed"}, {"target": "communication", "path": "epoch-4.error.kind", "op": "eq", "value": "operation_conflict"}, {"target": "effects", "path": "duplicate_completion", "op": "absent"}]}},
    {"id": "WF22-checkpoint-resume", "scenario_number": 22, "mechanism": "committed checkpoint is resume boundary", "initial_state": {"work": "work-ops", "checkpoint": "cp-1", "uncommitted_step": "step-2"}, "action": "rebuild_after_interrupt", "expected": {"assertions": [{"target": "state", "path": "resume_step", "op": "eq", "value": "step-2"}, {"target": "state", "path": "last_checkpoint", "op": "eq", "value": "cp-1"}, {"target": "authority", "path": "resume_boundary.source", "op": "eq", "value": "event_log"}]}},
    {"id": "WF23-idempotent-retry", "scenario_number": 23, "mechanism": "same idempotency identity has one effect", "initial_state": {"work": "work-alpha", "idempotency_identity": "intent-1"}, "action": "retry_same_action", "expected": {"assertions": [{"target": "effects", "path": "native_effect.count", "op": "eq", "value": 1}, {"target": "communication", "path": "replay", "op": "eq", "value": true}, {"target": "state", "path": "idempotency.identity", "op": "eq", "value": "intent-1"}]}},
    {"id": "WF24-stale-attempt", "scenario_number": 24, "mechanism": "stale attempt epoch is refused", "initial_state": {"work": "work-ops", "current_epoch": 8, "supplied_epoch": 7}, "action": "complete_external_step", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "operation_conflict"}, {"target": "effects", "path": "step_result", "op": "absent"}]}},
    {"id": "WF25-operator-takeover-approval", "scenario_number": 25, "mechanism": "takeover requires valid approval_ref", "initial_state": {"work": "work-ops", "stuck": true, "approval_ref": null}, "action": "takeover_attempt", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "approval_required"}, {"target": "authority", "path": "attempt.owner_changed", "op": "eq", "value": false}]}},
    {"id": "WF26-closed-condition-resolvers", "scenario_number": 26, "mechanism": "each await_type resolves through owning authority and cancellation is explicit", "initial_state": {"work": "work-ops", "await_types": ["pr_merge", "ci_result", "timer", "human_approval", "remote_work_state"], "cancellable_condition": "timer-2", "cancellation_authority": "operator"}, "action": "resolve_conditions", "expected": {"assertions": [{"target": "state", "path": "resolved.await_types", "op": "set_eq", "value": ["pr_merge", "ci_result", "timer", "human_approval", "remote_work_state"]}, {"target": "state", "path": "condition.timer-2.state", "op": "eq", "value": "cancelled"}, {"target": "authority", "path": "condition.timer-2.cancellation_authority", "op": "eq", "value": "operator"}, {"target": "authority", "path": "resolution.evidence", "op": "nonempty"}, {"target": "effects", "path": "polling", "op": "absent"}]}},
    {"id": "WF27-condition-block-relation", "scenario_number": 27, "mechanism": "conditions are ordinary blocks with unreadable fail-closed semantics", "initial_state": {"work": "work-ops", "condition": "ci-1", "condition_readable": false}, "action": "derive_ready", "expected": {"assertions": [{"target": "result", "path": "ready", "op": "eq", "value": false}, {"target": "authority", "path": "unknown.condition", "op": "nonempty"}, {"target": "effects", "path": "automatic_rewrite", "op": "absent"}]}},
    {"id": "WF28-no-polling-authority", "scenario_number": 28, "mechanism": "conditions resolve only on explicit request or consequential boundary", "initial_state": {"work": "work-ops", "condition": "timer-1", "clock": "trusted", "resolver_calls": 1}, "action": "explicit_resolve", "expected": {"assertions": [{"target": "effects", "path": "polling_loop", "op": "absent"}, {"target": "effects", "path": "timer_daemon", "op": "absent"}, {"target": "effects", "path": "automatic_downstream_rewrite", "op": "absent"}, {"target": "authority", "path": "resolver.trigger", "op": "eq", "value": "explicit_request"}]}},
    {"id": "WF29-impact-notice-identity", "scenario_number": 29, "mechanism": "declared edges produce one notice per exact six-part identity", "initial_state": {"work": "work-alpha", "source_contract_version": 1, "edge": "depends_on", "entity_kind": "spec", "entity_ref": "spec:one", "target_work_id": "work-child", "severity": "breaking"}, "action": "complete", "expected": {"assertions": [{"target": "state", "path": "impact_notices.count", "op": "eq", "value": 1}, {"target": "state", "path": "impact_notices.0.source_work_id", "op": "eq", "value": "work-alpha"}, {"target": "state", "path": "impact_notices.0.source_contract_version", "op": "eq", "value": 1}, {"target": "state", "path": "impact_notices.0.entity_kind", "op": "eq", "value": "spec"}, {"target": "state", "path": "impact_notices.0.entity_ref", "op": "eq", "value": "spec:one"}, {"target": "state", "path": "impact_notices.0.target_work_id", "op": "eq", "value": "work-child"}, {"target": "state", "path": "impact_notices.0.severity", "op": "eq", "value": "breaking"}, {"target": "state", "path": "impact_notices.0.notice_id", "op": "eq", "value": "notice:3443b8a55c9f3fce4d6188b08b07a45f117cf0c31d8d88481b386f2cfd30ba9e"}, {"target": "effects", "path": "duplicate_notice", "op": "absent"}]}},
    {"id": "WF30-breaking-dependent-block", "scenario_number": 30, "mechanism": "hard breaking dependency blocks downstream execution", "initial_state": {"source": "work-alpha", "target": "work-child", "edge": "hard depends_on", "severity": "breaking"}, "action": "start_downstream", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "invariant_violation"}, {"target": "state", "path": "work-child.state", "op": "not_eq", "value": "running"}, {"target": "effects", "path": "downstream_started", "op": "absent"}]}},
    {"id": "WF31-end-state-revision-impact", "scenario_number": 31, "mechanism": "revision warns or breaks based on active hard dependent consumption", "initial_state": {"source": "work-alpha", "dependent_consumed_prior_contract": true, "edge": "hard depends_on"}, "action": "supersede_contract", "expected": {"assertions": [{"target": "state", "path": "notice.severity", "op": "eq", "value": "breaking"}, {"target": "effects", "path": "workflow.impact_notice_recorded", "op": "nonempty"}]}},
    {"id": "WF32-forward-successor-completes", "scenario_number": 32, "mechanism": "successor and current workflow retain independent authority", "initial_state": {"work": "work-beta", "successor": "work-child"}, "action": "link_and_complete", "expected": {"assertions": [{"target": "state", "path": "work-beta.state", "op": "eq", "value": "completed"}, {"target": "state", "path": "work-child.authority", "op": "nonempty"}, {"target": "effects", "path": "nested_execution", "op": "absent"}]}},
    {"id": "WF33-forbid-nested-composition", "scenario_number": 33, "mechanism": "spikes and changes do not nest under forbidden families", "initial_state": {"work": "work-spike", "successor_kinds": ["architecture_spike", "implementation"], "relation": "nested"}, "action": "link_successor", "expected": {"assertions": [{"target": "communication", "path": "error.kind", "op": "eq", "value": "invalid_relation"}, {"target": "effects", "path": "nested_spike", "op": "absent"}, {"target": "effects", "path": "nested_change", "op": "absent"}]}},
    {"id": "WF34-generic-forward-any-family", "scenario_number": 34, "mechanism": "generic one-off forwards without copying semantics", "initial_state": {"work": "work-alpha", "kind": "generic_one_off", "successor_kind": "static_analysis"}, "action": "link_successor", "expected": {"assertions": [{"target": "state", "path": "successor.kind", "op": "eq", "value": "static_analysis"}, {"target": "state", "path": "successor.definition_ref", "op": "nonempty"}, {"target": "effects", "path": "copied_semantics", "op": "absent"}]}},
    {"id": "WF35-rebuild-byte-equal", "scenario_number": 35, "mechanism": "rebuild from events equals live projections", "initial_state": {"work": "work-alpha", "live_projection_hash": "hash-live", "event_log": "complete"}, "action": "rebuild", "expected": {"assertions": [{"target": "state", "path": "rebuilt_projection_hash", "op": "eq", "value": "hash-live"}, {"target": "authority", "path": "source", "op": "eq", "value": "event_log"}, {"target": "effects", "path": "direct_table_authority", "op": "absent"}]}},
