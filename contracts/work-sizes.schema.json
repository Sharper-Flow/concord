{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/contracts/work-sizes.schema.json",
  "title": "Concord work-item size vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "summary", "sizes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "summary": {"type": "string", "minLength": 2, "maxLength": 2048},
    "sizes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/work_size"}
    }
  },
  "$defs": {
    "work_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "summary"],
      "properties": {
        "size": {"type": "string", "minLength": 2, "maxLength": 32, "pattern": "^[a-z][a-z0-9_]*$"},
        "summary": {"type": "string", "minLength": 2, "maxLength": 512}
      }
    }
  }
}
