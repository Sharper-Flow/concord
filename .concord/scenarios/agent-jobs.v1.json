{
 "schema_version": "1.0",
 "contract": "TS1",
 "contract_status": "accepted",
 "fixture_sources": [
  "https://raw.githubusercontent.com/Sharper-Flow/concord/main/.concord/scenarios/product-memory-query.v1.json"
 ],
 "assertion_contract": {
  "required_fields": [
   "target",
   "path",
   "op"
  ],
  "targets": [
   "state",
   "result",
   "communication",
   "effects",
   "authority"
  ],
  "ops": [
   "eq",
   "not_eq",
   "contains",
   "not_contains",
   "set_eq",
   "unique",
   "nonempty",
   "absent"
  ]
 },
 "runner_requirements": {
  "passing_rule": "all assertions and named shared invariants must pass",
  "trajectory_policy": "reference trajectories are illustrative unless exact_order_required is true",
  "mutation_oracle": "assert resulting authoritative state, not response wording",
  "required_measurements": [
   "tools_exposed",
   "tools_considered",
   "calls",
   "retries",
   "typed_errors",
   "schema_prompt_tokens",
   "output_bytes",
   "latency_ms",
   "operator_interventions",
   "outcome"
  ]
 },
 "shared_invariants": {
  "correct_scope": "ambient singular scope is used; ambiguity and intentional cross-Product scope are explicit",
  "canonical_authority": "no stale or derived substitute is presented as current authority",
  "atomic_core_effect": "one SQLite domain operation has one observable all-or-nothing transaction",
  "evidence_authority": "required evidence and approval are verified before consequence",
  "honest_recovery": "partial, stale, invalid, exhausted, and recovery outcomes are structural",
  "retry_safe": "replaying the same intent does not duplicate effects",
  "bounded_context": "outputs are bounded and distinguish empty, ambiguous, degraded, and unreachable",
  "no_silent_scope_cut": "accepted obligations are not omitted without explicit human direction",
  "stable_evolution": "recorded contract versions remain interpretable"
 },
 "jobs": [
  {
   "id": "AJ1",
   "name": "orient_and_choose_work"
  },
  {
   "id": "AJ2",
   "name": "explain_blocked_work"
  },
  {
   "id": "AJ3",
   "name": "capture_needed_work"
  },
  {
   "id": "AJ4",
   "name": "transition_work_with_evidence"
  },
  {
   "id": "AJ5",
   "name": "relate_and_scope_work"
  },
  {
   "id": "AJ8",
   "name": "execute_operational_work"
  }
 ],
 "scenarios": [
  {
   "id": "AJ1-ambient-ready-work",
   "job_id": "AJ1",
   "instruction": "Orient me to this Product and select the highest-priority work I can start now.",
   "initial_state": {
    "fixture": "PM1",
    "ambient_project": "proj-web"
   },
   "expected": {
    "assertions": [
     {
      "target": "result",
      "path": "resolved_product_id",
      "op": "eq",
      "value": "prod-alpha"
     },
     {
      "target": "result",
      "path": "selected_work_id",
      "op": "eq",
      "value": "work-ready-high"
     },
     {
      "target": "result",
      "path": "selected_work_id",
      "op": "not_eq",
      "value": "work-blocked"
     },
     {
      "target": "communication",
      "path": "ready_work_evidence",
      "op": "nonempty"
     },
     {
      "target": "authority",
      "path": "stored_ready_flag_used",
      "op": "eq",
      "value": false
     }
    ],
    "invariants": [
     "correct_scope",
     "canonical_authority",
     "bounded_context"
    ]
   }
  },
  {
