{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Sharper-Flow/concord/main/.concord/schemas/knowledge-record.v1.schema.json",
  "title": "Concord typed knowledge record v1 (proposed)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "kind", "scope", "provenance", "status", "authority", "version", "body", "references"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"$ref": "#/$defs/recordId"},
    "kind": {"enum": ["constitution", "decision", "spec", "lesson", "research", "reference", "work_note"]},
    "scope": {"$ref": "#/$defs/scope"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "status": {"$ref": "#/$defs/status"},
    "authority": {"$ref": "#/$defs/authority"},
    "version": {"$ref": "#/$defs/version"},
    "body": {
      "oneOf": [
        {"$ref": "#/$defs/constitutionBody"},
        {"$ref": "#/$defs/decisionBody"},
        {"$ref": "#/$defs/specBody"},
        {"$ref": "#/$defs/lessonBody"},
        {"$ref": "#/$defs/researchBody"},
        {"$ref": "#/$defs/referenceBody"},
        {"$ref": "#/$defs/workNoteBody"}
      ]
    },
    "references": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/typedReference"}
    }
  },
  "allOf": [
    {"if": {"properties": {"kind": {"const": "constitution"}}, "required": ["kind"]}, "then": {"properties": {"body": {"$ref": "#/$defs/constitutionBody"}, "status": {"properties": {"state": {"enum": ["current", "superseded"]}}}}}},
    {"if": {"properties": {"kind": {"const": "decision"}}, "required": ["kind"]}, "then": {"properties": {"body": {"$ref": "#/$defs/decisionBody"}, "status": {"properties": {"state": {"enum": ["current", "superseded"]}}}}}},
    {"if": {"properties": {"kind": {"const": "spec"}}, "required": ["kind"]}, "then": {"properties": {"body": {"$ref": "#/$defs/specBody"}, "status": {"properties": {"state": {"enum": ["current", "superseded"]}}}}}},
    {"if": {"properties": {"kind": {"enum": ["lesson", "research", "reference", "work_note"]}}, "required": ["kind"]}, "then": {"properties": {"status": {"properties": {"state": {"enum": ["current", "historical", "superseded"]}}}}}}
  ],
  "$defs": {
    "recordId": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[a-z][a-z0-9_-]{2,127}$"},
    "elementId": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^(section|requirement):[a-z][a-z0-9_-]{2,120}$"},
    "sourceId": {"type": "string", "minLength": 7, "maxLength": 128, "pattern": "^source:[a-z][a-z0-9_-]{2,120}$"},
    "boundedMarkdown": {"type": "string", "minLength": 1, "maxLength": 16384},
    "shortText": {"type": "string", "minLength": 1, "maxLength": 512},
    "idList": {"type": "array", "minItems": 0, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "product_ids", "project_ids", "domain_ids", "work_ids", "tags"],
      "properties": {
        "mode": {"enum": ["home", "explicit"]},
        "product_ids": {"$ref": "#/$defs/idList"},
        "project_ids": {"$ref": "#/$defs/idList"},
        "domain_ids": {"$ref": "#/$defs/idList"},
        "work_ids": {"$ref": "#/$defs/idList"},
        "tags": {"$ref": "#/$defs/idList"}
      },
      "allOf": [{
        "if": {"properties": {"mode": {"const": "home"}}, "required": ["mode"]},
        "then": {"properties": {"product_ids": {"maxItems": 0}, "project_ids": {"maxItems": 0}, "domain_ids": {"maxItems": 0}, "work_ids": {"maxItems": 0}, "tags": {"maxItems": 0}}}
      }]
    },
    "sha256": {"type": "string", "minLength": 71, "maxLength": 71, "pattern": "^sha256:[0-9a-f]{64}$"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_path", "source_revision", "source_digest", "authored_at", "author", "location_authority"],
      "properties": {
        "canonical_path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\.concord/(?![\\s\\S]*\\.\\.)[a-zA-Z0-9._/-]+\\.json$"},
        "source_revision": {"type": "string", "minLength": 7, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{6,127}$"},
        "source_digest": {"$ref": "#/$defs/sha256"},
        "authored_at": {"type": "string", "minLength": 20, "maxLength": 40, "format": "date-time"},
        "author": {"$ref": "#/$defs/shortText"},
        "location_authority": {"enum": ["canonical", "operator_override"]},
        "override": {"$ref": "#/$defs/locationOverride"}
      },
      "allOf": [
        {"if": {"properties": {"location_authority": {"const": "canonical"}}, "required": ["location_authority"]}, "then": {"not": {"required": ["override"]}}},
        {"if": {"properties": {"location_authority": {"const": "operator_override"}}, "required": ["location_authority"]}, "then": {"required": ["override"]}}
      ]
    },
    "locationOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "path", "approved_by", "reason"],
      "properties": {
        "scope": {"enum": ["repository", "product", "project", "work"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!/)(?![\\s\\S]*\\.\\.)[a-zA-Z0-9._/-]+\\.json$"},
        "approved_by": {"enum": ["operator"]},
        "reason": {"$ref": "#/$defs/shortText"}
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "effective_at"],
      "properties": {
        "state": {"enum": ["current", "historical", "superseded"]},
        "effective_at": {"type": "string", "minLength": 20, "maxLength": 40, "format": "date-time"},
        "successor_id": {"$ref": "#/$defs/recordId"},
        "reason": {"$ref": "#/$defs/shortText"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "superseded"}}, "required": ["state"]}, "then": {"required": ["successor_id"]}},
        {"if": {"properties": {"state": {"enum": ["current", "historical"]}}, "required": ["state"]}, "then": {"not": {"required": ["successor_id"]}}}
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "description": "CD-0159 D3: the standing of the record, a sibling of status. legislated_by carries the approving work id and contract_version the contract version that fixed legislated standing; both are required exactly when the tier is legislated.",
      "required": ["tier"],
      "properties": {
        "tier": {"type": "string", "enum": ["legislated", "derived"]},
        "legislated_by": {"$ref": "#/$defs/recordId"},
        "contract_version": {"type": "integer", "minimum": 1, "maximum": 2147483647}
      },
      "allOf": [
        {"if": {"properties": {"tier": {"const": "legislated"}}, "required": ["tier"]}, "then": {"required": ["legislated_by", "contract_version"]}},
        {"if": {"properties": {"tier": {"const": "derived"}}, "required": ["tier"]}, "then": {"not": {"anyOf": [{"required": ["legislated_by"]}, {"required": ["contract_version"]}]}}}
      ]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_version", "schema_version", "content_digest"],
      "properties": {
        "record_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "schema_version": {"const": "1.0"},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "previous_digest": {"$ref": "#/$defs/sha256"},
        "migration_id": {"type": "string", "minLength": 3, "maxLength": 128, "pattern": "^migration:[a-z][a-z0-9_-]{2,120}$"}
      },
      "allOf": [{
        "if": {"properties": {"record_version": {"const": 1}}, "required": ["record_version"]},
        "then": {"not": {"anyOf": [{"required": ["previous_digest"]}, {"required": ["migration_id"]}]}}
      }, {
        "if": {"properties": {"record_version": {"minimum": 2}}, "required": ["record_version"]},
        "then": {"required": ["previous_digest", "migration_id"]}
      }]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "narrative", "requirements"],
      "properties": {
        "id": {"type": "string", "minLength": 9, "maxLength": 128, "pattern": "^section:[a-z][a-z0-9_-]{2,120}$"},
        "title": {"$ref": "#/$defs/shortText"},
        "narrative": {"$ref": "#/$defs/boundedMarkdown"},
        "requirements": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/requirement"}}
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "narrative", "normative", "source_ids", "verification_refs"],
      "properties": {
        "id": {"type": "string", "minLength": 12, "maxLength": 128, "pattern": "^requirement:[a-z][a-z0-9_-]{2,120}$"},
        "narrative": {"$ref": "#/$defs/boundedMarkdown"},
        "normative": {"type": "boolean"},
        "source_ids": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceId"}},
        "verification_refs": {"type": "array", "minItems": 0, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/recordId"}}
      }
    },
    "normativeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "locator", "revision", "digest", "supports"],
      "properties": {
        "id": {"$ref": "#/$defs/sourceId"},
        "kind": {"enum": ["constitution", "decision", "spec", "lesson", "research", "reference", "work_note", "external"]},
        "locator": {"type": "string", "minLength": 1, "maxLength": 1024},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "digest": {"$ref": "#/$defs/sha256"},
        "supports": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/elementId"}}
      }
    },
    "commonBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["narrative", "sections", "normative_sources"],
      "properties": {
        "narrative": {"$ref": "#/$defs/boundedMarkdown"},
        "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}},
        "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}},
        "principles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}},
        "precedence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}},
        "choice": {"$ref": "#/$defs/boundedMarkdown"},
        "alternatives": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}},
        "consequences": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}},
        "contract": {"$ref": "#/$defs/boundedMarkdown"},
        "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/acceptanceCriterion"}},
        "lesson": {"$ref": "#/$defs/boundedMarkdown"},
        "findings": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}},
        "sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}},
        "reference": {"$ref": "#/$defs/boundedMarkdown"},
        "locators": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}},
        "outcome": {"$ref": "#/$defs/boundedMarkdown"},
        "actions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}},
        "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}
      }
    },
    "constitutionBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["principles", "precedence"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "principles": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}, "precedence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}}}}]},
    "decisionBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["choice", "alternatives", "consequences"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "choice": {"$ref": "#/$defs/boundedMarkdown"}, "alternatives": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}, "consequences": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}}}]},
    "specBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["contract", "acceptance_criteria"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "contract": {"$ref": "#/$defs/boundedMarkdown"}, "acceptance_criteria": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/acceptanceCriterion"}}}}]},
    "lessonBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["lesson", "evidence"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "lesson": {"$ref": "#/$defs/boundedMarkdown"}, "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}}}]},
    "researchBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["findings", "sources"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "findings": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}, "sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}}}}]},
    "referenceBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["reference", "locators"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "reference": {"$ref": "#/$defs/boundedMarkdown"}, "locators": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/shortText"}}}}]},
    "workNoteBody": {"allOf": [{"$ref": "#/$defs/commonBody"}, {"type": "object", "additionalProperties": false, "required": ["outcome", "actions", "evidence"], "properties": {"narrative": {"$ref": "#/$defs/boundedMarkdown"}, "sections": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/section"}}, "normative_sources": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/normativeSource"}}, "outcome": {"$ref": "#/$defs/boundedMarkdown"}, "actions": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}, "evidence": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/boundedMarkdown"}}}}]},
    "acceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "verification"],
      "properties": {
        "id": {"type": "string", "minLength": 12, "maxLength": 128, "pattern": "^requirement:[a-z][a-z0-9_-]{2,120}$"},
        "statement": {"$ref": "#/$defs/boundedMarkdown"},
        "verification": {"$ref": "#/$defs/shortText"}
      }
    },
    "typedReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relation", "target_record_id", "scope"],
      "properties": {
        "id": {"type": "string", "minLength": 5, "maxLength": 128, "pattern": "^ref:[a-z][a-z0-9_-]{2,120}$"},
        "relation": {"enum": ["supports", "depends_on", "refines", "supersedes", "cites", "implements", "derived_from", "conflicts_with"]},
        "target_record_id": {"$ref": "#/$defs/recordId"},
        "target_element_id": {"$ref": "#/$defs/elementId"},
        "scope": {"enum": ["normative", "contextual"]}
      }
    }
  }
}
