  "intake": {
    "skill": "concord-work-shaping",
    "checks": [
      "freshness",
      "overtaken",
      "already_delivered",
      "still_reproducible",
      "observed_or_theoretical",
      "defect_or_feature",
      "duplicate_or_overlap",
      "right_owner",
      "conflicts",
      "value",
      "cost_against_value",
      "one_outcome_or_several",
      "checkable_end_state",
      "blocked"
    ],
    "outcomes": [
      "proceed",
      "clarify",
      "already_handled",
      "decline",
      "split_or_merge"
    ],
    "clarify": {
      "skill": "concord-work-shaping",
      "runs_only_when_intake_found_open_questions": true
    }
  },
  "plan_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "workflow step plan v1",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "type",
      "steps"
    ],
    "properties": {
      "schema_version": {
        "const": "1.0"
      },
      "type": {
        "enum": [
          "change",
          "fix",
          "research",
          "removal"
        ]
      },
      "steps": {
        "type": "array",
        "minItems": 1,
        "maxItems": 64,
        "items": {
          "$ref": "#/$defs/step"
        }
      }
    },
    "$defs": {
      "step": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "after",
          "reviewed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
          },
          "required": {
            "type": "boolean"
          },
          "after": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]{1,63}$"
            },
            "uniqueItems": true
          },
          "skill": {
            "type": [
              "string",
              "null"
            ]
          },
          "helper": {
            "type": [
              "string",
              "null"
            ]
          },
          "reviewed": {
            "type": "boolean"
          },
          "attempts": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/attempt"
            }
          }
        }
      },
      "attempt": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "note",
          "completed_at"
        ],
        "properties": {
          "note": {
            "type": "string",
            "minLength": 2,
            "maxLength": 4096
          },
          "completed_at": {
            "type": "string"
          },
          "completion_seq": {
            "type": "integer",
            "minimum": 0
          },
          "actor": {
            "type": "string"
          },
          "reviewer": {
            "type": "string"
          },
          "result": {
            "enum": [
              "pass",
              "fixed"
            ]
          },
          "commit": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        }
      }
    }
  }
}
